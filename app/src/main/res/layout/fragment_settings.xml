<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Current Provider Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/darker_gray"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCurrentProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前 AI 提供商: 未配置"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型: N/A"
                android:textSize="12sp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- API Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ai_config"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnChangeApiKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_select_provider"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Cache Management -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_data_mgmt"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_clear_cache"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCacheInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="缓存大小: 0 KB"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- 回溯参数管理（walk-forward 固化参数） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="回溯参数（三年 walk-forward 拟合）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导入他人拟合好的参数 JSON 立即生效；也可导出当前参数分享。"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvParamsSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前参数来源: APK 内置"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnImportParams"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="导入参数文件（JSON）"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportParams"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="导出当前参数"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnResetParams"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="恢复内置参数"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Agent Framework -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent Framework"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全局模式"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgGlobalMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbOldSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Legacy"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbNewAgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Agent"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbPerModule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hybrid"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvModuleConfigTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模块级别配置"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swStockPicking"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="选股模块（AI Pipeline）"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swStockAnalysis"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="分析模块（单股深度分析）"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swTradeExecution"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="交易模块（买卖执行）"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swChat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="对话模块（AI 聊天）"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swNewsMonitor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="新闻监控模块"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swRiskManagement"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="风控模块"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 週期級別路線（Phase 10） -->
        <TextView
            android:id="@+id/tvPeriodRouteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="週期級別路線（策略執行）"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swRouteUltraShort"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="超短線 → Agent(QUICK)"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swRouteShort"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="短線 → Agent(QUICK)"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swRouteMid"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="中線 → Agent(PIPELINE)"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swRouteLong"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="長線 → Agent(V2)"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- 做T 微信通知（Phase 11） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="做T 微信通知 &amp; 自动执行"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="做T信号出现时推送微信，置信度超阈值可自动执行买卖"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/swWechatEnabled"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ServerChan 微信通知"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etServerChanKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="ServerChan SendKey（https://sct.ftqq.com 获取）"
            android:textSize="12sp"
            android:inputType="text"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swPushPlusEnabled"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PushPlus 微信通知"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPushPlusToken"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="PushPlus Token（https://www.pushplus.plus 获取）"
            android:textSize="12sp"
            android:inputType="text"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/swAutoExecute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="自动执行（置信度超阈值自动买卖）"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAutoExecThreshold"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="自动执行置信度阈值（默认 0.7，范围 0~1）"
            android:textSize="12sp"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:layout_marginBottom="24dp" />

        <!-- 语言设置 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_language"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_select_language"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCurrentLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前语言: 跟随系统"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- 应用更新（App 自更新） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="应用更新"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="配置更新清单地址后，可手动检查或启动时自动检查新版本并下载安装"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvUpdateVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前版本: v1.0"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etUpdateUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="更新清单地址（latest.json 完整 URL）"
            android:textSize="12sp"
            android:inputType="textUri"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSaveUpdateUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="保存更新地址"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="检查更新"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- 云端数据同步（腾讯云 COS） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="云端数据同步（腾讯云 COS）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="将每日策略结果打包上传 COS，供 PC 回溯拟合；也可下载 PC 拟合好的最新参数并立即生效。"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCloudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="云端同步未配置"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloudUpload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="上传今日数据到 COS"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloudDownloadParams"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="下载最新拟合参数"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloudDownloadDb"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="下载云端行情库（PC 市场库）"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_about"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="StockAnalysis v2.0"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>

