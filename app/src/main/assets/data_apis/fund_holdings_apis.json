{
  "apis": [
    {
      "id": "eastmoney_f10_jjcc",
      "name": "東方財富 F10 基金持股",
      "enabled": true,
      "description": "東方財富股票 F10 頁面的基金持股數據，返回持倉基金列表（基金名稱、代碼、持股數、持股市值、占流通股比例）",
      "url_template": "https://emweb.securities.eastmoney.com/PC_HSF10/ShareholderResearch/PageAjax?code={SECUCODE}",
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Referer": "https://emweb.securities.eastmoney.com/"
      },
      "params": {
        "code": "{SECUCODE}"
      },
      "param_mapping": {
        "SECUCODE": {
          "description": "東方財富格式股票代碼（如 SH603986、SZ002371）",
          "rule": "6開頭用SH，0/3開頭用SZ，4/8開頭用BJ",
          "examples": {
            "sh603986": "SH603986",
            "sz002371": "SZ002371"
          }
        }
      },
      "response": {
        "format": "JSON",
        "data_path": "jjcc",
        "fields": {
          "HOLDER_NAME": "基金名稱",
          "FUND_CODE": "基金代碼",
          "FUND_DERIVECODE": "基金完整代碼（含交易所後綴）",
          "TOTAL_SHARES": "持股數量（股）",
          "HOLD_VALUE": "持股市值（元）",
          "TOTALSHARES_RATIO": "占總股本比例（小數，如 0.07 表示 7%）",
          "FREESHARES_RATIO": "占流通股比例（小數）",
          "FREE_MARKET_CAP": "流通市值（元）",
          "FREE_SHARES": "自由流通持股數",
          "SECURITY_CODE": "股票代碼",
          "REPORT_DATE": "報告期（如 2026-03-31）",
          "ORG_TYPE": "機構類型（01=基金）",
          "NETVALUE_RATIO": "基金淨值相關比率"
        },
        "sample_data": [
          {
            "ORG_TYPE": "01",
            "HOLDER_NAME": "易方達藍籌精選混合",
            "FUND_CODE": "005827",
            "FUND_DERIVECODE": "005827.OF",
            "TOTAL_SHARES": 1100000,
            "HOLD_VALUE": 261313570.0,
            "TOTALSHARES_RATIO": 0.15705515,
            "FREESHARES_RATIO": 0.16469334,
            "REPORT_DATE": "2026-03-31"
          }
        ]
      },
      "notes": [
        "數據來源：東方財富 emweb F10 股東研究頁面",
        "更新頻率：季度更新（Q1/Q2/Q3/Q4 報告）",
        "數據時效性：最新報告期為上一季度（如當前Q2期間顯示Q1數據）",
        "無需認證，無調用次數限制",
        "返回完整基金持股列表（不僅TOP10），可按持股市值排序"
      ],
      "tested_at": "2026-07-07",
      "test_status": "SUCCESS",
      "test_stock": "SH603986（兆易創新）",
      "test_result": "返回 34KB JSON，包含完整基金持股明細數據"
    },
    {
      "id": "tushare_fund_stock_portfolio",
      "name": "Tushare 基金持股",
