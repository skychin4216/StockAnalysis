{
  "apis": [
    {
      "id": "eastmoney_f10_jjcc",
      "name": "东方财富 F10 基金持股",
      "enabled": true,
      "description": "东方财富股票 F10 页面的基金持股数据，返回持仓基金列表（基金名称、代码、持股数、持股市值、占流通股比例）",
      "url_template": "https://emweb.securities.eastmoney.com/PC_HSF10/ShareholderResearch/PageAjax?code={SECUCODE}",
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Referer": "https://emweb.securities.eastmoney.com/"
      },
      "params": {
        "code": "{SECUCODE}"
      },
      "param_mapping": {
        "SECUCODE": {
          "description": "东方财富格式股票代码（如 SH603986、SZ002371）",
          "rule": "6开头用SH，0/3开头用SZ，4/8开头用BJ",
          "examples": {
            "sh603986": "SH603986",
            "sz002371": "SZ002371"
          }
        }
      },
      "response": {
        "format": "JSON",
        "data_path": "jjcc",
        "fields": {
          "HOLDER_NAME": "基金名称",
          "FUND_CODE": "基金代码",
          "FUND_DERIVECODE": "基金完整代码（含交易所后缀）",
          "TOTAL_SHARES": "持股数量（股）",
          "HOLD_VALUE": "持股市值（元）",
          "TOTALSHARES_RATIO": "占总股本比例（小数，如 0.07 表示 7%）",
          "FREESHARES_RATIO": "占流通股比例（小数）",
          "FREE_MARKET_CAP": "流通市值（元）",
          "FREE_SHARES": "自由流通持股数",
          "SECURITY_CODE": "股票代码",
          "REPORT_DATE": "报告期（如 2026-03-31）",
          "ORG_TYPE": "机构类型（01=基金）",
          "NETVALUE_RATIO": "基金净值相关比率"
        },
        "sample_data": [
          {
            "ORG_TYPE": "01",
            "HOLDER_NAME": "易方达蓝筹精选混合",
            "FUND_CODE": "005827",
            "FUND_DERIVECODE": "005827.OF",
            "TOTAL_SHARES": 1100000,
            "HOLD_VALUE": 261313570.0,
            "TOTALSHARES_RATIO": 0.15705515,
            "FREESHARES_RATIO": 0.16469334,
            "REPORT_DATE": "2026-03-31"
          }
        ]
      },
      "notes": [
        "数据来源：东方财富 emweb F10 股东研究页面",
        "更新频率：季度更新（Q1/Q2/Q3/Q4 报告）",
        "数据时效性：最新报告期为上一季度（如当前Q2期间显示Q1数据）",
        "无需认证，无调用次数限制",
        "返回完整基金持股列表（不仅TOP10），可按持股市值排序"
      ],
      "tested_at": "2026-07-07",
      "test_status": "SUCCESS",
      "test_stock": "SH603986（兆易创新）",
      "test_result": "返回 34KB JSON，包含完整基金持股明细数据"
    },
    {
      "id": "tushare_fund_stock_portfolio",
      "name": "Tushare 基金持股",
      "enabled": false,
      "description": "Tushare Pro 提供 fund_stock_portfolio 接口查询基金持股明细，需要注册并获取 token",
      "url_template": "https://api.tushare.pro",
      "method": "POST",
      "auth": {
        "type": "api_key",
        "param": "token",
        "signup_url": "https://tushare.pro/register"
      },
      "api_name": "fund_stock_portfolio",
      "params": {
        "ts_code": "{FUND_CODE}",
        "period": "{REPORT_DATE}"
      },
      "notes": [
        "需要 Tushare Pro token（免费注册，积分限制调用频率）",
        "查询维度：基金代码 → 持有哪些股票（反向查询）",
        "不支持：股票代码 → 哪些基金持有（需要先知道持仓基金列表）",
        "单次最大 10000 条",
        "Python SDK: pip install tushare; ts.fund_stock_portfolio(ts_code='005827.OF')"
      ],
      "tested_at": "2026-07-07",
      "test_status": "SKIPPED",
      "reason": "需要 API token，且查询维度是基金→股票而非股票→基金"
    },
    {
      "id": "akshare_fund_individual_stock_info",
      "name": "AKShare 基金持仓",
      "enabled": false,
      "description": "AKShare 开源 Python 库，支持基金持股等数据查询",
      "auth": {
        "type": "none",
        "install": "pip install akshare"
      },
      "python_usage": "import akshare as ak; ak.fund_individual_stock_info(symbol='603986')",
      "notes": [
        "Python 库，非 HTTP 接口，无法直接在 Android 中调用",
        "数据底层来源可能也是东方财富",
        "适合服务端/本地脚本使用"
      ],
      "tested_at": "2026-07-07",
      "test_status": "SKIPPED",
      "reason": "Python 库，非 HTTP 接口，不适用于 Android 直接调用"
    },
