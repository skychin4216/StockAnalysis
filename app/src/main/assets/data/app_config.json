  "macro_environment": {
    "name": "宏观环境因子（影响风格轮动/选股核心/中长线高股息偏好）",
    "us_10y_yield_pct": 4.4,
    "us_10y_yield_high": 4.0,
    "usd_credit_weaken": true,
    "cn_10y_yield_pct": 1.7,
    "cn_10y_yield_low": 2.2,
    "oil_price": 82,
    "oil_price_high": 85,
    "oil_trend_rising": true,
    "high_dividend_prefer": true,
    "high_dividend_sectors": ["银行", "煤炭", "化工", "电力", "保险", "石油", "高速公路"],
    "logic": "美债利率高+美元信用下调 → 全球资金避险、人民币资产受青睐；中国国债收益率低 → 高股息类债资产(银行/煤炭/化工)性价比凸显，中线/长线应埋伏高股息；油价>85美元且处上涨趋势 → 化工产业链景气上行、低位埋伏优先（80美元仅为中高位，不足为强信号）"
  },

  "poolFilter": {
    "name": "增强过滤（smalltools/_pool_filters.py 搬回，长线豁免）",
