<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 市场公共研判 Pipeline（大盘多周期研判 → 风格轮动判断 → 板块强弱监测）

  三段式市场级研判，不碰个股信号，作为四周期 UseCase 的公共前置步骤：
    <pipeline ref="usecases/market_rotation_pipeline.xml" name="市场公共研判" />

  输出（存入共享 PipelineContext.stageOutputs，四周期私有 pipeline 后续节点可读取）：
    - stageOutputs["n_a_market"]        ：AMarketAnalysisEngine.MarketAnalysisResult（大盘六维：趋势/量能/情绪/状态机）
    - stageOutputs["n_sector_strength"] ：SectorStrengthResult（板块强弱 TopN + 主力资金 + 热门天数）
    - stageOutputs["n_style_rotation"]  ：StyleRotationResult（风格轮动判断 + 建议周期 + 风险等级）
-->
<DagPipeline id="market_rotation_dag" name="市场公共研判Pipeline"
    description="大盘多周期研判→风格轮动判断→板块强弱监测">

  <NodeList>
    <!-- 数据准备 -->
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="60" />
        <param name="minSnapshots" value="50" />
      </config>
    </Node>
    <!-- 1. 大盘多周期研判（六维：趋势/量能/情绪/资金/指标/风险） -->
    <Node id="n_a_market" name="大盘多周期研判" module="a_market_analysis" />
    <!-- 2. 板块强弱监测（近 N 日板块涨幅/热度/主力资金排序） -->
    <Node id="n_sector_strength" name="板块强弱监测" module="sector_strength" />
    <!-- 3. 大盘方向研判（趋势+温度 → BULLISH/OSCILLATION/BEARISH，供周期矩阵路由 if 条件使用）
         注意：节点 id 必须独立于 n_adaptive（adaptive_params），否则会被选股公共管线覆盖 -->
    <Node id="n_market_direction" name="大盘方向研判" module="market_direction" />
    <!-- 4. 风格轮动判断（大盘环境 + 板块强弱 → 风格标签/建议周期/风险） -->
    <Node id="n_style_rotation" name="风格轮动判断" module="style_rotation" />
  </NodeList>

  <Links>
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_a_market</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_sector_strength</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_market_direction</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_style_rotation</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_sector_strength</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_style_rotation</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
