<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 机构持仓判定 Pipeline（V2 DAG · 汇总 → 季报判定 → 国家队/大基金 → 止损 四阶段）

  与同目录 usecase_pipeline.py（Python 引擎，XML DAG 主线）共用同一文件 —— 单一事实源。

  stageOutputs：
    - "n_inst_pool"      JSONObject {as_of, n, rows[]}
                         每行 {code,name,from,entry,bars[]}（bars 内嵌供下游止损定价）
    - "n_inst_judge"     JSONObject {as_of, n, a, b, c, period, available, rows[]}
                         每行附 {grade,score,label,hold_ratio,latest_chg,streak,net_chg,
                                 n_funds,holder_chg_pct,instVerdict}
    - "n_national_flow"  JSONObject {as_of, judge_day, counts{}, rows[]}
                         每行附 {natState/natStrong/natRatio/natChg/natEnd/natNotice/natNames,
                                 bigState/…, ssState/…, flowScore, flowLabel, semi}
    - "n_inst_stop"      JSONObject {rows[] 附 stop/stopPct/broken/stopTheory/momentum}

  判定口径（《机构持续加仓自动选股池.txt》，算法单一事实源 = smalltools/_inst_holdings.py，
  产物 _inst_holdings.json 已含 grade，双端只读不算，避免三处口径漂移）：
    口径A（严格）连续 ≥2 期、持股比例环比增持 > 0.5pp
    口径B（宽松）全程净增持 > 1pp
    机构加仓分 ins(0~100) = 持仓水平分(≤30) + 本期环比分(≤25) + 连续增持期数×12(≤30)
                            + 基金家数环比(±5)
    集中度   conc(0~100) = 持仓占比分(≤60) + 股东户数下降分(≤40)
    综合分   score = 0.6×ins + 0.4×conc
    分级      A=口径A 且 score≥75 ｜ B=(A或B) 且 score≥50 ｜ C=其余（散户票）
  ★ 机构季报天然滞后 1-3 月：只做中长线定性，不作实时信号。

  ★ 2026-09-13 新增阶段3「国家队/大基金持有进出」（module=national_flow）：
    数据资产 data/_national_flow_hist.json，判定算法单一事实源 = smalltools/_national_flow.py。
    本链的标的池 = 「三周期选股 + ETF 全行业扫描 + ETF top5 + 实仓」汇总（n_inst_pool），
    因此**三个选股链与实仓链都会自动带上**国家队/大基金口径，无需各自改造。
    默认 annotate（只贴标签、保持 A/B/C 排序）；若想直接筛掉没有国家队/大基金流入的票，
    把 mode 改为 filter 并按需打开 requireNat / requireBig / excludeOut / minScore。
-->
<DagPipeline id="inst_holding_dag" name="机构持仓判定Pipeline"
    description="选股池+实仓汇总 → 机构季报判定(A精选/B观察/C散户票) → 国家队/大基金持有进出 → 多理论投票止损">

  <NodeList>
    <!-- ── 阶段1：汇总「三大周期选股 + ETF全行业扫描 + ETF top5 + 实仓」全部股票 ── -->
    <Node id="n_inst_pool" name="选股池+实仓汇总" module="inst_pool_build">
      <config>
        <param name="includeHoldings" value="true" />
        <param name="maxRows" value="200" />
        <param name="embedBars" value="true" />
        <param name="barsLimit" value="140" />
      </config>
    </Node>

    <!-- ── 阶段2：机构季报判定（纯资产计算，离线可跑）── -->
    <Node id="n_inst_judge" name="机构持仓判定" module="inst_holding_judge">
      <config>
        <param name="sourceNode" value="n_inst_pool" />
        <param name="gradeFilter" value="" />
        <param name="maxRows" value="200" />
      </config>
    </Node>

    <!-- ── 阶段3：国家队/大基金持有进出（默认贴标签；要筛票就改 mode=filter）── -->
    <Node id="n_national_flow" name="国家队/大基金持有进出" module="national_flow">
      <config>
        <param name="sourceNode" value="n_inst_judge" />
        <param name="mode" value="annotate" />
        <param name="requireNat" value="false" />
        <param name="requireBig" value="false" />
        <param name="excludeOut" value="false" />
        <param name="minScore" value="50" />
        <param name="maxRows" value="200" />
        <param name="strategyText" value="十大流通股东法定披露：国家队(中央汇金/证金) + 大基金(国家集成电路产业投资基金等) + 社保；NOTICE_DATE≤信号日无未来函数；连续≥2期缺席判「退出」；流入按连续确认期数加权(国家队≥3期/大基金·社保≥2期)" />
      </config>
    </Node>

    <!-- ── 阶段4：多理论投票止损（六理论取最保守 + 棘轮；行内嵌 bars 定价）── -->
    <Node id="n_inst_stop" name="多理论投票止损" module="stop_loss_vote">
      <config>
        <param name="target" value="picks" />
        <param name="sourceNode" value="n_national_flow" />
        <param name="period" value="MID" />
        <param name="marketState" value="auto" />
        <param name="trailUp" value="true" />
      </config>
    </Node>

    <!-- ── 阶段5：月内机构买入检测 + 机构保送订单（2026-09-17 用户需求）──
         对全池（三周期 + ETF 全行业扫描 + ETF top5 + 实仓）检测近 35 天披露的
         十大流通股东机构增持（国家队/社保/大基金/公募/险资/QFII/北向）；
         命中票直接保送到生成订单 node，是否买入或拦截由买入订单 node 的最终
         操作决定（趋势/形态/口诀检查全走）；命中即 view log 红色标注（🚨）。 -->
    <Node id="n_inst_buy" name="月内机构买入检测" module="inst_buy_recent">
      <config>
        <param name="sourceNode" value="n_inst_pool" />
        <param name="topN" value="80" />
        <param name="noticeDays" value="35" />
        <param name="endDays" value="130" />
      </config>
    </Node>
    <!-- ── 阶段5b：★ 超级权限闸（priority level = 0，2026-09-19 用户需求）──
         "国家队(汇金/证金/国新/梧桐树) + 社保养老 **同时** 在近 7 天内披露买入" →
         最高置信度，写成 superDirectHits 直达 n_orders（跳过趋势/形态/口诀三重拦截）。
         等级体系：0 超级权限 > 4 资金流直达 > 3 激进 > 2 常规 > 1 严格。
         ⚠️ 持仓披露是季度粒度，"买入时间"用披露日 NOTICE_DATE 近似（真实成交日不可得）。 -->
    <Node id="n_super" name="★超级权限(国家队+社保双买入)" module="super_holder_gate">
      <config>
        <param name="sourceNode" value="n_inst_buy" />
        <param name="noticeDays" value="30" />
        <param name="requireBoth" value="true" />
        <param name="level" value="0" />
        <!-- mode 两档（2026-09-19 回测对比，见 _super_holder_backtest.py）：
             recent = 严格：近 noticeDays 天「双买入」（样本少、胜率略高：T+5 66.7% vs 53.6%）
             hold   = 宽松：「没卖出就能买」（最新一期仍持有且未减持；样本多 1147 条，
                      但 T+5 胜率 53.6%、均收益 +0.75% 并未提高，且 32.3% 的信号在
                      下一期显示机构已退出/减持 → 披露滞后风险，故默认仍用 recent） -->
        <param name="mode" value="triple" />
      </config>
    </Node>
    <Node id="n_orders" name="买入订单生成（机构保送+超级权限）" module="generate_orders">
      <config>
        <param name="sourceNode" value="n_super" />
        <param name="directField" value="instBuyHits,superDirectHits" />
        <param name="maxHoldings" value="5" />
        <param name="orderType" value="MidTermQuant" />
      </config>
    </Node>
  </NodeList>

  <Links>
    <Link>
      <SourceNodeId>n_inst_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_judge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_inst_judge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_national_flow</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_national_flow</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_stop</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_inst_stop</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_buy</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_inst_buy</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_super</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_super</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
