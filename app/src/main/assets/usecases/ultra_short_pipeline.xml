<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 超短線量化 DAG Pipeline — 高通 Camera Pipeline 風格

  超短線特徵：持倉 1 天，純技術面，隔夜情緒溢價，快進快出。
  流程最精簡，不加熱點/輪動等中長線專有節點。

  共 20 個 Node：
    Layer 0 (並行): market_context, bg_manager, adaptive_params（大盤防守）, data_import
    Layer 1: stock_pool, ma_convergence, holding_guard（並行）
    Layer 1.5: candidate_pool（候選池過濾，補齊 Hardcode）
    Layer 2: signal_merge（策略動態注入在 Java 層完成）
    Layer 3: sector_boost → bounce_reversal → inst_tips（依賴 signal_merge）
    Layer 4: smart_money_filter（依賴 inst_tips，閾值30——超短V型票主力分天然低）
    Layer 5: ai_predict（依賴 smart_money_filter，最終裁切 take 5）
    Layer 6: generate_orders（依賴 ai_predict + adaptive_params）
    Layer 7: swap_weak（依賴 generate_orders，持倉滿時賣弱買強）
    Layer 8: position_merge（依賴 swap_weak，換鳥後再入庫）
    Layer 9 (並行): t1_auto_sell（依賴 position_merge）, fitting_save（依賴 generate_orders）
    並行輔助: candle_pattern（依賴 smart_money_filter，形態警示）
-->
<DagPipeline id="ultra_short_dag" name="超短線量化DAG Pipeline" description="市場上下文→股票池→策略篩選→板塊加權→主力過濾→AI精選→訂單生成→持倉合併/擬合保存">

  <!-- ══════════ NodeList ══════════ -->
  <NodeList>
    <!-- 數據準備 Layer 0 -->
    <Node id="n_import" name="數據導入檢查" module="data_import">
      <config>
        <param name="days" value="30" />
        <param name="minSnapshots" value="100" />
      </config>
    </Node>
    <Node id="n_ctx" name="市場上下文" module="market_context" />
    <Node id="n_bg" name="後臺暫停/恢復" module="bg_manager" />
    <Node id="n_adaptive" name="大盤分析+自適應參數" module="adaptive_params" />

    <!-- Layer 1 -->
    <Node id="n_pool" name="股票池" module="stock_pool" />

    <!-- 大盤均線檢查 Pipeline 分組 -->
    <Pipeline id="market_check" name="大盤均線檢查">
      <NodeList>
        <Node id="n_ma_unified" name="大盤均線統一檢查" module="market_ma_unified">
          <config>
            <param name="threshold" value="0.015" />
            <param name="checkMode" value="full" />
          </config>
        </Node>
      </NodeList>
    </Pipeline>

    <!-- Layer 1（並行）: 持倉風控 — 每次必跑，評估止損/止盈/策略退出 -->
    <Node id="n_guard" name="持倉風控" module="holding_guard" />

    <!-- Layer 1.5: 候選池過濾（補齊 Hardcode） -->
    <Node id="n_cand" name="候選池過濾" module="candidate_pool" />

    <!-- 聚合 Layer 2 -->
    <Node id="n_merge" name="信號合併" module="signal_merge" />

    <!-- 增強 Layer 3 -->
    <Node id="n_boost" name="板塊加權" module="sector_boost" />
    <Node id="n_bounce" name="跌後反彈加分" module="bounce_reversal" />
    <Node id="n_strict" name="六項嚴選檢查" module="strict_selection" />
    <Node id="n_ancestral" name="大A祖訓" module="ancestral_rules">
      <config><param name="holdingPeriod" value="ULTRA_SHORT" /></config>
    </Node>
    <Node id="n_inst_tips" name="機構線索加分" module="inst_tips" />

    <!-- AI+過濾 Layer 4-5 -->
    <Node id="n_ai" name="AI精選" module="ai_predict" />
    <Node id="n_smart" name="主力資金過濾" module="smart_money_filter">
      <config>
        <param name="minScore" value="30" />
      </config>
    </Node>
    <Node id="n_candle" name="K線形態偵測" module="candle_pattern" />

    <!-- 訂單生成 Layer 6 -->
    <Node id="n_orders" name="買入訂單生成" module="generate_orders">
      <config>
        <param name="maxHoldings" value="3" />
        <param name="orderType" value="UltraShortQuant" />
      </config>
    </Node>

    <!-- 騰龍換鳥 Layer 7（持倉滿時賣弱買強） -->
    <Node id="n_swap" name="騰龍換鳥" module="swap_weak">
      <config>
        <param name="maxHoldings" value="3" />
      </config>
    </Node>

    <!-- 持倉合併 + T+1賣出 + 擬合 Layer 8-9 -->
    <Node id="n_merge_pos" name="持倉合併" module="position_merge" />
    <Node id="n_t1sell" name="T+1自動賣出" module="t1_auto_sell">
      <config>
        <param name="stopLossPct" value="-2.0" />
        <param name="takeProfitPct" value="3.0" />
      </config>
    </Node>
    <Node id="n_fit" name="擬合計算+保存" module="fitting_save" />
  </NodeList>

  <!-- ══════════ Links ══════════ -->
  <Links>
    <!-- Layer 0 → 1: 數據導入 → 股票池（確保數據充足） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 數據導入 → 大盤均線統一檢查（與股票池並行） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ma_unified</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 股票池 -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 持倉風控（並行，每次必評估持倉） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 1.5: 股票池 → 候選池過濾 -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_cand</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 2: 候選池過濾 → 信號合併（策略動態注入在 Java 層完成） -->
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 信號合併 → 板塊加權 -->
    <Link>
      <SourceNodeId>n_merge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板塊加權 → 跌後反彈加分 -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_bounce</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 嚴選: 跌後反彈加分 → 六項嚴選檢查 -->
    <Link>
      <SourceNodeId>n_bounce</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_strict</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 嚴選 → 3.5b: 六項嚴選檢查 → 大A祖訓 -->
    <Link>
      <SourceNodeId>n_strict</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ancestral</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5b → 3.6: 大A祖訓 → 機構線索加分 -->
    <Link>
      <SourceNodeId>n_ancestral</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_tips</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.6 → 4: 機構線索加分 → 主力資金過濾（先過濾再AI精選） -->
    <Link>
      <SourceNodeId>n_inst_tips</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 主力資金過濾 → AI精選（最終裁切 take 5） -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ai</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 5 → 6: AI精選 → 買入訂單生成 -->
    <Link>
      <SourceNodeId>n_ai</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 主力資金過濾 → K線形態偵測（並行，輔助提醒） -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_candle</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 6: 大盤分析 → 買入訂單生成（自適應參數注入，空頭防守） -->
    <Link>
      <SourceNodeId>n_adaptive</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 6 → 7: 買入訂單生成 → 騰龍換鳥（持倉滿時賣弱買強） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_swap</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 騰龍換鳥 → 持倉合併（換鳥後再入庫，避免超持） -->
    <Link>
      <SourceNodeId>n_swap</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge_pos</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 持倉合併 → T+1 自動賣出 -->
    <Link>
      <SourceNodeId>n_merge_pos</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_t1sell</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 6 → 7: 買入訂單生成 → 擬合保存（並行） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_fit</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
