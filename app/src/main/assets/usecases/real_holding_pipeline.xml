<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 實倉分析 DAG Pipeline v2

  使用 AMarketAnalysisEngine 進行六維大盤分析：
    1. 趨勢與形態（3日不新低 / 均線粘合 / 逃頂信號）
    2. 量能狀態（放量/縮量/平量）
    3. 市場情緒（漲跌比 → 沸騰/溫和/冰點）
    4. 狀態機決策（推薦週期 + 倉位建議）

  結構：
    Layer 0: data_import, bg_manager
    Layer 1: a_market_analysis（大盤K線六維分析）
    Layer 2: real_holding_eval（逐持倉K線分析 + 操作建議）

  擴展方式（在 NodeList 和 Links 中添加）：
    Layer 3: t_trade_eval（做T/反T建議，讀取 n_a_market + n_rh_eval）
    Layer 4: report_gen（持倉報告生成，聚合所有分析結果）

  大盤分析結果存入 context["n_a_market"]，
  其他周期 Pipeline 也可直接加入 n_a_market 節點復用大盤分析。
-->
<DagPipeline id="real_holding_dag" name="實倉分析DAG Pipeline v2"
    description="大盤K線六維分析→逐持倉評估→操作建議">

  <NodeList>
    <!-- Layer 0: 數據源（並行） -->
    <Node id="n_import" name="數據導入檢查" module="data_import">
      <config>
        <param name="days" value="30" />
        <param name="minSnapshots" value="50" />
      </config>
    </Node>
    <Node id="n_bg" name="後臺暫停/恢復" module="bg_manager" />

    <!-- Layer 1: A股大盤K線分析（六維綜合） -->
    <Node id="n_a_market" name="大盤K線分析" module="a_market_analysis" />

    <!-- Layer 2: 實倉持倉評估（逐股K線分析 + 操作建議） -->
    <Node id="n_rh_eval" name="實倉持倉評估" module="real_holding_eval" />
  </NodeList>

  <Links>
    <!-- Layer 0 → 1: 數據導入 → 大盤K線分析 -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_a_market</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 大盤分析 → 實倉評估 -->
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rh_eval</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
