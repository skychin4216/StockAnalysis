<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 实仓分析 DAG Pipeline v3

  使用 AMarketAnalysisEngine 进行六维大盘分析：
    1. 趋势与形态（3日不新低 / 均线粘合 / 逃顶信号）
    2. 量能状态（放量/缩量/平量）
    3. 市场情绪（涨跌比 → 沸腾/温和/冰点）
    4. 状态机决策（推荐周期 + 仓位建议）

  v3 新增：
    - 新闻因子：实时新闻力度计算（使用 LocalDate.now() 获取最新新闻）
    - 做T评估：基于支撑/阻力位生成做T/反T信号

  结构：
    Layer 0: data_import, bg_manager
    Layer 1: a_market_analysis, news_strength（并行）
    Layer 2: real_holding_eval（逐持仓K线分析 + 新闻因子 + 操作建议）
    Layer 3: t_trade_eval（做T/反T建议）

  大盘分析结果存入 context["n_a_market"]，
  新闻力度存入 context["n_news"]，
  其他周期 Pipeline 也可直接加入这些节点复用。
-->
<DagPipeline id="real_holding_dag" name="实仓分析DAG Pipeline v3"
    description="大盘分析+新闻因子→逐持仓评估→做T建议">

  <NodeList>
    <!-- Layer 0: 数据源（并行） -->
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="30" />
        <param name="minSnapshots" value="50" />
      </config>
    </Node>
    <Node id="n_bg" name="后台暂停/恢复" module="bg_manager" />

    <!-- Layer 1: A股大盘K线分析 + 新闻力度（并行） -->
    <Node id="n_a_market" name="大盘K线分析" module="a_market_analysis" />
    <Node id="n_news" name="新闻力度" module="news_strength">
      <config>
        <!-- 使用实时新闻，不依赖 tradeDate -->
        <param name="useRealTime" value="true" />
      </config>
    </Node>

    <!-- Layer 2: 实仓持仓评估（逐股K线分析 + 新闻因子 + 操作建议） -->
    <Node id="n_rh_eval" name="实仓持仓评估" module="real_holding_eval" />

    <!-- Layer 3: 做T/反T建议 -->
    <Node id="n_t_trade" name="做T评估" module="t_trade_eval">
      <config>
        <param name="basePositionRatio" value="0.3" />
        <param name="maxSignalsPerStock" value="2" />
      </config>
    </Node>
  </NodeList>

  <Links>
    <!-- Layer 0 → 1: 数据导入 → 大盘K线分析 -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_a_market</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 数据导入 → 新闻力度 -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_news</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 大盘分析 + 新闻 → 实仓评估 -->
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rh_eval</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_news</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rh_eval</TargetNodeId>
      <TargetPortId>1</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 实仓评估 → 做T评估 -->
    <Link>
      <SourceNodeId>n_rh_eval</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_t_trade</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
