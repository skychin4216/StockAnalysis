<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 实仓分析 DAG Pipeline v4

  v4 增强：
    - 数据导入扩展到120天（支持更长的K线分析）
    - 新增持仓诊断分析：多维度健康评分(技术/风险/资金) + 板块风险 + 组合健康度
    - 新增持仓走势预测：短期趋势预测 + 支撑/阻力位 + 场景分析 + 操作计划
    - 新增龙头状态分析：对照板块龙头监测信号，识别持仓是否属龙头及板块强弱
    - 保留原有：大盘分析、新闻因子、逐股评估、做T建议

  结构：
    Layer 0: data_import(120d), bg_manager
    Layer 1: a_market_analysis, news_strength, leader_analysis（并行）
    Layer 2: real_holding_eval, holding_diagnostic（并行）
    Layer 3: holding_prediction（综合诊断+大盘+新闻→走势预测）
    Layer 4: t_trade_eval（做T/反T建议）
-->
<DagPipeline id="real_holding_dag" name="实仓分析DAG Pipeline v4"
    description="大盘分析+新闻→逐股评估+诊断→走势预测→做T建议">

  <NodeList>
    <!-- Layer 0: 数据源（并行） -->
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="120" />
        <param name="minSnapshots" value="50" />
      </config>
    </Node>
    <Node id="n_bg" name="后台暂停/恢复" module="bg_manager" />

    <!-- Layer 1: A股大盘K线分析 + 新闻力度 + 龙头状态分析（并行） -->
    <Node id="n_a_market" name="大盘K线分析" module="a_market_analysis" />
    <Node id="n_news" name="新闻力度" module="news_strength">
      <config>
        <param name="useRealTime" value="true" />
      </config>
    </Node>
    <Node id="n_leader_analysis" name="龙头状态分析" module="sector_leader_analysis" />

    <!-- Layer 2: 逐股评估 + 持仓诊断（并行） -->
    <Node id="n_rh_eval" name="实仓持仓评估" module="real_holding_eval" />
    <Node id="n_holding_diag" name="持仓诊断分析" module="holding_diagnostic" />

    <!-- Layer 3: 走势预测（综合诊断+大盘+新闻） -->
    <Node id="n_holding_predict" name="持仓走势预测" module="holding_prediction" />

    <!-- Layer 4: 做T/反T建议 -->
    <Node id="n_t_trade" name="做T评估" module="t_trade_eval">
      <config>
        <param name="basePositionRatio" value="0.3" />
        <param name="maxSignalsPerStock" value="2" />
      </config>
    </Node>
  </NodeList>

  <Links>
    <!-- Layer 0 → 1: 数据导入 → 大盘分析 + 新闻 -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_a_market</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_news</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_leader_analysis</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 大盘+新闻 → 实仓评估 -->
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rh_eval</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_news</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rh_eval</TargetNodeId>
      <TargetPortId>1</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 大盘+新闻 → 持仓诊断 -->
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holding_diag</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_news</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holding_diag</TargetNodeId>
      <TargetPortId>1</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 诊断 → 走势预测 -->
    <Link>
      <SourceNodeId>n_holding_diag</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holding_predict</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <!-- Layer 1 → 3: 大盘+新闻 → 走势预测（直接注入） -->
    <Link>
      <SourceNodeId>n_a_market</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holding_predict</TargetNodeId>
      <TargetPortId>1</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_news</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holding_predict</TargetNodeId>
      <TargetPortId>2</TargetPortId>
    </Link>

    <!-- Layer 3 → 4: 走势预测 → 做T评估 -->
    <Link>
      <SourceNodeId>n_holding_predict</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_t_trade</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
