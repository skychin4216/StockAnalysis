<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 实仓分析 UseCase v2

  结构设计为可扩展的多 Pipeline 架构：
    Step 1: 大盘分析 Pipeline（可被其他 UseCase 复用）
    Step 2: 持仓评估 Pipeline（读取大盘结论 + 逐股分析）

  后续扩展方向：
    - Step 3: 持仓报告生成 Pipeline（生成 PDF/图表报告）
    - Step 4: 做T建议 Pipeline（综合大盘+个股K线 → 做T/反T信号）
    - 其他周期 UseCase 可引用 step 1 的市场分析结果

  大盘分析结果存入 PipelineContext，所有后续 Pipeline 均可读取。
-->
<usecase id="real_holding" name="实仓分析">
  <description>大盘K线六维分析→逐持仓评估→操作建议(持有/做T/减仓/清仓)</description>
  <steps>
    <!-- Step 1: 实仓 DAG Pipeline（大盘分析 + 持仓评估） -->
    <pipeline ref="usecases/real_holding_pipeline.xml" name="实仓DAG流程" />

    <!--
      后续扩展：在此添加更多 pipeline step
      例如：
      <pipeline ref="usecases/real_holding_report_pipeline.xml" name="持仓报告生成" />
      <pipeline ref="usecases/real_holding_ttrade_pipeline.xml" name="做T建议" />
    -->
  </steps>
  <config>
    <param name="orderType" value="RealHolding" />
    <param name="holdingPeriod" value="all" />
    <param name="marketAnalysisOnly" value="false" />
  </config>
</usecase>
