<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 短線量化 DAG Pipeline v2 — 高通 Camera Pipeline 風格

  短線特徵：持倉 1 天~2 週，技術面為主，資金情緒脈衝，要熱點熱點熱點。
  含熱度計算、新聞攔截、騰龍換鳥等短線專有節點。

  共 22 個 Node：
    Layer 0 (並行): market_context, multi_period_hot, bg_manager, adaptive_params（大盤防守）
    Layer 1: stock_pool（依賴 market_context）
    Layer 1.5 (並行): candidate_pool, zipline_factor（補齊 Hardcode，依賴 stock_pool）
    Layer 2 (並行): signal_merge（策略動態注入）, heat_score（依賴 stock_pool）
    Layer 3: sector_boost（依賴 signal_merge）→ bounce_reversal → inst_tips
    Layer 3.5 (並行): news_strength, rotation_penalty（依賴 sector_boost）
    Layer 4: smart_money_filter（依賴 inst_tips + news_strength）
    Layer 5: news_guard（依賴 smart_money_filter）
    Layer 6: ai_predict（依賴 news_guard，最終裁切 take 5）
    Layer 7: generate_orders（依賴 ai_predict + adaptive_params）
    Layer 8: swap_weak（依賴 generate_orders，持倉滿時賣弱買強）
    Layer 9: position_merge（依賴 swap_weak，換鳥後再入庫）, fitting_save（依賴 generate_orders，並行）
    Layer 10: crosstab_publish（依賴 position_merge）
    並行輔助: candle_pattern（依賴 smart_money_filter，形態警示）
-->
<DagPipeline id="short_term_dag" name="短線量化DAG Pipeline" description="市場上下文→多周期熱門→股票池→策略篩選+熱度→板塊加權→新聞力度/輪動懲罰→主力過濾→新聞攔截→AI精選→訂單生成→持倉合併/騰龍換鳥/擬合保存">

  <!-- ══════════ NodeList ══════════ -->
  <NodeList>
    <!-- 數據源 Layer 0（並行） -->
    <Node id="n_import" name="數據導入檢查" module="data_import">
      <config>
        <param name="days" value="60" />
        <param name="minSnapshots" value="100" />
      </config>
    </Node>
    <Node id="n_ctx" name="市場上下文" module="market_context" />
    <Node id="n_multihot" name="多周期熱門股聚合" module="multi_period_hot" />
    <Node id="n_bg" name="後臺暫停/恢復" module="bg_manager" />
    <Node id="n_adaptive" name="大盤分析+自適應參數" module="adaptive_params" />

    <!-- Layer 1 -->
    <Node id="n_pool" name="股票池" module="stock_pool" />

    <!-- 大盤均線檢查 Pipeline 分組 -->
    <Pipeline id="market_check" name="大盤均線檢查">
      <NodeList>
        <Node id="n_ma_unified" name="大盤均線統一檢查" module="market_ma_unified">
          <config>
            <param name="threshold" value="0.02" />
            <param name="checkMode" value="full" />
          </config>
        </Node>
      </NodeList>
    </Pipeline>

    <!-- Layer 1（並行）: 持倉風控 — 每次必跑，評估止損/止盈/策略退出 -->
    <Node id="n_guard" name="持倉風控" module="holding_guard" />

    <!-- Layer 1.5: 候選池過濾 + Zipline 因子預計算（補齊 Hardcode） -->
    <Node id="n_cand" name="候選池過濾" module="candidate_pool" />
    <Node id="n_zipline" name="Zipline因子計算" module="zipline_factor" />

    <!-- Layer 1.5b: 盤中 K 線分析（交易時段自動獲取分鐘線） -->
    <Node id="n_intraday" name="盤中K線分析" module="intraday_analysis">
      <config>
        <param name="intervalMin" value="5" />
        <param name="minBars" value="5" />
      </config>
    </Node>

    <!-- 聚合 Layer 2（並行） -->
    <Node id="n_merge" name="信號合併" module="signal_merge" />
    <Node id="n_heat" name="熱度計算" module="heat_score" />

    <!-- 增強 Layer 3 -->
    <Node id="n_boost" name="板塊加權" module="sector_boost" />
    <Node id="n_bounce" name="跌後反彈加分" module="bounce_reversal" />
    <Node id="n_strict" name="六項嚴選檢查" module="strict_selection">
      <config>
        <param name="peThreshold" value="40.0" />
        <param name="maDivergenceThreshold" value="0.025" />
        <param name="turnoverThreshold" value="2.5" />
        <param name="lookbackDays" value="40" />
        <param name="minPassCount" value="4" />
      </config>
    </Node>
    <Node id="n_ancestral" name="大A祖訓" module="ancestral_rules">
      <config><param name="holdingPeriod" value="SHORT" /></config>
    </Node>
    <Node id="n_inst_tips" name="機構線索加分" module="inst_tips" />

    <!-- 新聞力度+輪動懲罰 Layer 3.5（並行評分，存入 context 供主力過濾讀取） -->
    <Node id="n_news_str" name="新聞力度計算" module="news_strength">
      <config>
        <param name="lookbackDays" value="3" />
      </config>
    </Node>
    <Node id="n_rot_pen" name="板塊輪動懲罰" module="rotation_penalty">
      <config>
        <param name="thresholdDays" value="3" />
        <param name="penaltyPerExcess" value="10" />
      </config>
    </Node>

    <!-- AI+過濾 Layer 4-5 -->
    <Node id="n_ai" name="AI精選" module="ai_predict" />
    <Node id="n_smart" name="主力資金過濾" module="smart_money_filter">
      <config>
        <param name="minScore" value="55" />
      </config>
    </Node>
    <Node id="n_candle" name="K線形態偵測" module="candle_pattern" />

    <!-- 新聞攔截 Layer 6 -->
    <Node id="n_newsguard" name="新聞攔截+技術過濾" module="news_guard">
      <config>
        <param name="impactThreshold" value="75" />
        <param name="sentimentThreshold" value="-30" />
      </config>
    </Node>

    <!-- 訂單生成 Layer 7 -->
    <Node id="n_orders" name="買入訂單生成" module="generate_orders">
      <config>
        <param name="maxHoldings" value="6" />
        <param name="orderType" value="ShortTermQuant" />
      </config>
    </Node>

    <!-- 騰龍換鳥 Layer 8 + 持倉合併 Layer 9 + 擬合（並行） -->
    <Node id="n_merge_pos" name="持倉合併" module="position_merge" />
    <Node id="n_crosstab" name="跨Tab發布" module="crosstab_publish" />
    <Node id="n_swap" name="騰龍換鳥" module="swap_weak">
      <config>
        <param name="maxHoldings" value="6" />
      </config>
    </Node>
    <Node id="n_fit" name="擬合計算+保存" module="fitting_save" />
  </NodeList>

  <!-- ══════════ Links ══════════ -->
  <Links>
    <!-- Layer 0 → 1: 數據導入 → 股票池（確保數據充足） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 數據導入 → 大盤均線統一檢查（與股票池並行） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ma_unified</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 股票池 -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 持倉風控（並行，每次必評估持倉） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 1.5: 股票池 → 候選池過濾 -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_cand</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 1.5: 候選池過濾 → Zipline 因子計算 -->
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_zipline</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 1.5b: 候選池過濾 → 盤中K線分析 -->
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_intraday</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 2: Zipline 因子計算 → 信號合併（策略動態注入在 Java 層完成） -->
    <Link>
      <SourceNodeId>n_zipline</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 熱度計算 -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_heat</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 信號合併 → 板塊加權 -->
    <Link>
      <SourceNodeId>n_merge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 熱度計算 → 板塊加權（熱度作為板塊加權輸入） -->
    <Link>
      <SourceNodeId>n_heat</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板塊加權 → 跌後反彈加分 -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_bounce</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 嚴選: 跌後反彈加分 → 六項嚴選檢查 -->
    <Link>
      <SourceNodeId>n_bounce</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_strict</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 嚴選 → 3.5b: 六項嚴選檢查 → 大A祖訓 -->
    <Link>
      <SourceNodeId>n_strict</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ancestral</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板塊加權 → 新聞力度計算（並行評分） -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_news_str</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板塊加權 → 板塊輪動懲罰（並行評分） -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rot_pen</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5b → 3.6: 大A祖訓 → 機構線索加分 -->
    <Link>
      <SourceNodeId>n_ancestral</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_tips</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.6 → 4: 機構線索加分 → 主力資金過濾（先過濾再AI精選） -->
    <Link>
      <SourceNodeId>n_inst_tips</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 4: 新聞力度 → 主力資金過濾（新聞評分存入context供後續讀取） -->
    <Link>
      <SourceNodeId>n_news_str</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 主力資金過濾 → 新聞攔截+技術過濾 -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_newsguard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 主力資金過濾 → K線形態偵測（並行，輔助提醒） -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_candle</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 5 → 6: 新聞攔截 → AI精選（最終裁切 take 5） -->
    <Link>
      <SourceNodeId>n_newsguard</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ai</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 6 → 7: AI精選 → 買入訂單生成 -->
    <Link>
      <SourceNodeId>n_ai</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 7: 大盤分析 → 買入訂單生成（自適應參數注入，空頭防守） -->
    <Link>
      <SourceNodeId>n_adaptive</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 買入訂單生成 → 騰龍換鳥（持倉滿時賣弱買強） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_swap</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 8 → 9: 騰龍換鳥 → 持倉合併（換鳥後再入庫，避免超持） -->
    <Link>
      <SourceNodeId>n_swap</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge_pos</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 8 → 9: 持倉合併 → 跨 Tab 發布（補齊 Hardcode） -->
    <Link>
      <SourceNodeId>n_merge_pos</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_crosstab</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 買入訂單生成 → 擬合保存（並行） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_fit</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
