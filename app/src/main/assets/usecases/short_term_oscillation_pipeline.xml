<?xml version='1.0' encoding='UTF-8'?>
<DagPipeline id="short_term_dag_oscillation" name="short_term_pipeline_oscillation" description="多周期热门→策略筛选+热度→板块加权→新闻力度/轮动惩罚→主力过滤→新闻拦截→AI精选→订单生成→持仓合并/腾龙换鸟/拟合保存（公共 L0/L1 由 stock_picking_common_pipeline.xml 提供）（环境：震荡）">

  
  <NodeList>
    
    <Node id="n_multihot" name="多周期热门股聚合" module="multi_period_hot" />

    
    <Node id="n_cand" name="候选池过滤" module="candidate_pool" />
    <Node id="n_zipline" name="Zipline因子计算" module="zipline_factor" />

    
    <Node id="n_intraday" name="盘中K线分析" module="intraday_analysis">
      <config>
        <param name="intervalMin" value="5" />
        <param name="minBars" value="5" />
      </config>
    </Node>

    
    <Node id="n_merge" name="信号合并" module="signal_merge" />
    <Node id="n_heat" name="热度计算" module="heat_score" />

    
    <Node id="n_vp" name="量价因子加权" module="volume_price_factor">
      <config>
        <param name="mode" value="penalty" />
        <param name="benchmark" value="sh000300" />
        <param name="relWinDays" value="10" />
        <param name="rsHi" value="3.0" />
        <param name="rsBonus" value="4.0" />
        <param name="rsLo" value="-2.0" />
        <param name="rsPenalty" value="-3.0" />
        <param name="thinVr" value="0.5" />
        <param name="thinPenalty" value="-4.0" />
        <param name="shrinkVr" value="0.8" />
        <param name="shrinkPenalty" value="-2.0" />
        <param name="lowPriceMax" value="10.0" />
        <param name="leaderTopK" value="5" />
        <param name="leaderBonus" value="3.0" />
      </config>
    </Node>

    
    <Node id="n_boost" name="板块加权" module="sector_boost" />
    <Node id="n_bounce" name="跌后反弹加分" module="bounce_reversal" />
        <Node id="n_strict" name="均线粘合严选" module="strict_selection">
      <config>
        <param name="useMA60" value="true" />
        <param name="convergenceDurationDays" value="10" />
        <param name="convergenceDurationRatio" value="0.8" />
        <param name="requireChangePct" value="true" />
        <param name="requireAboveAllMAs" value="true" />
        <param name="swingLeftN" value="5" />
        <param name="swingRightN" value="2" />
        <param name="lookbackDays" value="60" />
        <param name="quietVolumeRatio" value="1.0" />
        <param name="period" value="short" />
      <param name="convergenceThreshold" value="4.0" /><param name="volumeBreakoutRatio" value="2.5" /><param name="minChangePct" value="2.0" /><param name="minDrawdownPct" value="5.0" /><param name="minPassCount" value="5" /><param name="requireThreeDayConfirm" value="false" /><param name="requireOpenBelowMAs" value="true" /><param name="requireCloseAboveConvergenceTop" value="true" /><param name="allowQuietRise" value="false" /><!-- v11: 企稳低吸旁路(连跌后3日不新低+低点抬高→免均线粘合, 2026-09-08, _stabilize_dip_stat.py) --><param name="allowStableDip" value="true" /><!-- v12: 强势延续旁路(多头排列+近20日高回撤≤nearHigh+量比≥volRatio+RSI6∈[lo,hi]→免粘合严选, 2026-09-10 改进B；PC 引擎 usecase_pipeline._strong_continuation 实现) --><param name="strongEnable" value="true" /><param name="strongRsiLo" value="55" /><param name="strongRsiHi" value="70" /><param name="strongNearHigh" value="3.0" /><param name="strongVolRatio" value="1.5" /><param name="strongScore" value="70" /></config>
    </Node>
    <Node id="n_ancestral" name="大A祖训" module="ancestral_rules">
      <config><param name="holdingPeriod" value="SHORT" /></config>
    </Node>
    <!-- 2026-09-12 K线口诀（《常见K线图.txt》口诀五条+经典/大型形态；可与 n_ancestral/n_event 口径对照，Python 端 kline_idiom 同构） -->
    <Node id="n_idiom" name="K线口诀" module="kline_idiom">
      <config><param name="bullBoost" value="0.6" /><param name="bearPenalty" value="1.2" /><param name="veto" value="false" /><param name="vetoStrength" value="4" /><param name="minBars" value="30" /><param name="period" value="SHORT" /></config>
    </Node>
    <Node id="n_inst_tips" name="机构线索加分" module="inst_tips" />

    
    <Node id="n_news_str" name="新闻力度计算" module="news_strength">
      <config>
        <param name="lookbackDays" value="3" />
      </config>
    </Node>
    <Node id="n_rot_pen" name="板块轮动惩罚" module="rotation_penalty">
      <config>
        <param name="thresholdDays" value="3" />
        <param name="penaltyPerExcess" value="10" />
      </config>
    </Node>

    
    <Node id="n_finance" name="财务健康筛选" module="financial_health" />
    <Node id="n_ai" name="AI精选" module="ai_predict" />
    <Node id="n_smart" name="主力资金过滤" module="smart_money_filter">
      <config>
        <param name="minScore" value="55" />
      </config>
    </Node>
    <Node id="n_candle" name="K线形态侦测" module="candle_pattern" />

    
    <Node id="n_newsguard" name="新闻拦截+技术过滤" module="news_guard">
      <config>
        <param name="impactThreshold" value="75" />
        <param name="sentimentThreshold" value="-30" />
      </config>
    </Node>

    
    <Node id="n_orders" name="买入订单生成" module="generate_orders">
      <config>
        <param name="maxHoldings" value="5" />
        <param name="orderType" value="ShortTermQuant" />
        <param name="totalCapRatio" value="25" />
        <param name="singlePositionRatio" value="6" />
      </config>
    </Node>

    
    <Node id="n_merge_pos" name="持仓合并" module="position_merge" />
    <Node id="n_crosstab" name="跨Tab发布" module="crosstab_publish" />
    <Node id="n_swap" name="腾龙换鸟" module="swap_weak">
      <config>
        <param name="maxHoldings" value="5" />
      </config>
    </Node>
  </NodeList>

  
  <Links>
    
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_zipline</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_intraday</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_zipline</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    

    
    <Link>
      <SourceNodeId>n_merge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_vp</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_vp</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_heat</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_multihot</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_bounce</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_bounce</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_strict</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_strict</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ancestral</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_news_str</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rot_pen</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_ancestral</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_idiom</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <Link>
      <SourceNodeId>n_idiom</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_tips</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_inst_tips</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_news_str</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_rot_pen</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_newsguard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_candle</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_newsguard</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_finance</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_finance</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ai</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_ai</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_swap</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_swap</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge_pos</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    
    <Link>
      <SourceNodeId>n_merge_pos</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_crosstab</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>