<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## ETF 持股 top5 Pipeline（V2 DAG · 覆盖矩阵 → 国家队ETF份额 → 国家队/大基金 → 止损 四阶段）

  与同目录 usecase_pipeline.py（Python 引擎，XML DAG 主线）共用同一文件 —— 单一事实源。

  stageOutputs：
    - "n_holdings_top5"  JSONObject {as_of, updated, fundsTotal, stocksTotal, rows[]}
                        每行 = {code,name,n,funds[],themes[],sumRatio,pos60,bars,close}
    - "n_nat_etf"        JSONObject {as_of, available, verdict, level, lines[],
                        quarterly{current,at,net_sub}, lastTurn{at,dir,netSub},
                        huijin{code,pct,names}, funds[], rows[]（透传上行）}
                        ★ 市场级横幅：国家队(汇金)宽基ETF份额动向（买/卖 + 时间点），不改行不筛行
    - "n_national_flow"  JSONObject {as_of, judge_day, counts{}, rows[]}
                        每行 = 上行 + {natState/natStrong/natRatio/natChg/natEnd/natNotice/natNames,
                        bigState/…, ssState/…, flowScore, flowLabel, semi}
    - "n_holdings_stop"  JSONObject {rows[] 附 stop/stopPct/broken/stopTheory}

  排序口径：n（被覆盖的行业ETF数）降序 → sumRatio（合计占净值比）降序 → pos60 升序。
  industryOnly=true 时剔除「仅被宽基 ETF 覆盖」的个股（宽基覆盖是 β 不是赛道共识）。
  本 usecase **不做大盘择时**：它是覆盖度排行榜（观察清单），是否出手由个股低吸/ETF筛选两条链决定。

  ★ 2026-09-13 新增阶段2「国家队(汇金)宽基ETF份额动向」（module=national_etf_share）：
    数据资产 data/_etf_share_signal.json + data/_etf_share_hist.json，判定算法单一事实源 =
    smalltools/_etf_share_flow.py，资产内 judge 已含结论，双端只读不算。与阶段3 分工互补：
      · national_etf_share = 宽基 ETF 份额(申赎) —— 市场级、每日可观测，汇金 2015 后主要借道；
      · national_flow      = 十大流通股东     —— 个股级、季报滞后。
    四象限：份额↑&价↓=低位承接(买) / 份额↓&价↑=高位派发(卖)；汇金身份只能年报§9.2点名。
    本阶段是市场级横幅（透传 rows、不改顺序、不筛行），供推送显示「国家队在买还是在卖 + 时间点」。

  ★ 2026-09-13 新增阶段3「国家队/大基金持有进出」（module=national_flow）：
    数据资产 data/_national_flow_hist.json，判定算法单一事实源 = smalltools/_national_flow.py，
    资产内 snap 已含判定结果，双端只读不算。硬约束三条（见 usecase_pipeline.py 节点 docstring）：
      ① 身份只取十大流通股东法定披露，ETF 申赎不计入国家队口径；
      ② NOTICE_DATE ≤ 信号日（无未来函数）；
      ③ 季度披露天然滞后 1-3 月 → 中长线定性，非实时信号。
    阶段3 只贴标签不改顺序；止损节点改为消费阶段3 的输出，标签因此透传到最终结果。
-->
<DagPipeline id="etf_holdings_top5_dag" name="ETF持股Top5Pipeline"
    description="ETF前五重仓覆盖矩阵 → 国家队ETF份额动向 → 国家队/大基金持有进出 → 多理论投票止损">

  <NodeList>
    <!-- ── 阶段1：覆盖矩阵排行（纯资产计算，不需行情；行内尽量内嵌 bars 供下游止损） ── -->
    <Node id="n_holdings_top5" name="ETF前五重仓覆盖矩阵排行" module="etf_holdings_rank">
      <config>
        <param name="topN" value="10" />
        <param name="minCoverage" value="2" />
        <param name="industryOnly" value="true" />
        <param name="baseThemes" value="宽基" />
        <param name="embedBars" value="true" />
        <param name="barsLimit" value="140" />
        <param name="minBars" value="60" />
        <param name="strategyText" value="ETF前五重仓覆盖矩阵：n=覆盖该股的行业ETF数（季报级）；n≥2 且非仅宽基覆盖才入榜；排序 n↓ / 合计权重↓ / pos60↑" />
      </config>
    </Node>

    <!-- ── 阶段2：国家队(汇金)宽基ETF份额动向（市场级横幅，透传 rows、不改顺序、不筛行）── -->
    <Node id="n_nat_etf" name="国家队(汇金)ETF份额动向" module="national_etf_share">
      <config>
        <param name="sourceNode" value="n_holdings_top5" />
        <param name="maxFunds" value="10" />
        <param name="emitFunds" value="true" />
        <param name="strategyText" value="宽基ETF份额(申赎)四象限：份额↑&amp;价↓=低位承接(买) / 份额↓&amp;价↑=高位派发(卖)；汇金身份取年报§9.2前十名持有人；日频快照给拐点时点，季度披露给方向" />
      </config>
    </Node>

    <!-- ── 阶段3：国家队/大基金持有进出贴标签（不改顺序、不筛行；filter 模式见 inst_holding_pipeline）── -->
    <Node id="n_national_flow" name="国家队/大基金持有进出" module="national_flow">
      <config>
        <param name="sourceNode" value="n_holdings_top5" />
        <param name="mode" value="annotate" />
        <param name="maxRows" value="200" />
        <param name="strategyText" value="十大流通股东法定披露：国家队(中央汇金/证金) + 大基金(国家集成电路产业投资基金等) + 社保；NOTICE_DATE≤信号日无未来函数；连续≥2期缺席判「退出」；流入按连续确认期数加权" />
      </config>
    </Node>

    <!-- ── 阶段4：多理论投票止损（六理论取最保守+棘轮）── -->
    <Node id="n_holdings_stop" name="多理论投票止损" module="stop_loss_vote">
      <config>
        <param name="target" value="picks" />
        <param name="sourceNode" value="n_national_flow" />
        <param name="period" value="MID" />
        <param name="marketState" value="auto" />
        <param name="trailUp" value="true" />
      </config>
    </Node>
  </NodeList>

  <Links>
    <Link>
      <SourceNodeId>n_holdings_top5</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_nat_etf</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_nat_etf</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_national_flow</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_national_flow</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_holdings_stop</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
