<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 短線量化 UseCase

  持倉 1 天~2 週，技術面為主，資金情緒脈衝。
  流程：市場上下文→多周期熱門→股票池→策略篩選+熱度→板塊加權→AI精選→主力過濾→新聞攔截→訂單生成→持倉合併/騰龍換鳥/擬合保存
-->
<usecase id="short_term" name="短線量化">
  <description>市場上下文→多周期熱門→股票池→策略篩選+熱度→板塊加權→AI精選→主力過濾→新聞攔截→訂單生成→持倉合併/騰龍換鳥/擬合保存</description>
  <steps>
    <pipeline ref="usecases/short_term_pipeline.xml" name="短線DAG流程" />
  </steps>
  <config>
    <param name="orderType" value="ShortTermQuant" />
    <param name="maxHoldings" value="3" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="short" />
  </config>
</usecase>
