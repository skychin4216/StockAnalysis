<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 量化选股 UseCase

  纯筛选，无交易，AI 在 UI 层异步调用。
  流程：数据准备 → 策略筛选（并行） → 合并加权
-->
<usecase id="screening" name="量化选股">
  <description>全市场扫描→多策略并行筛选→信号合并→板块加权</description>
  <steps>
    <pipeline ref="usecases/data_prep_pipeline.xml" name="数据准备" />
    <pipeline ref="usecases/strategy_screening_pipeline.xml" parallel="true" name="策略筛选" />
    <pipeline ref="usecases/merge_boost_pipeline.xml" name="合并加权" />
  </steps>
  <config>
    <param name="orderType" value="Screening" />
    <param name="maxHoldings" value="0" />
  </config>
</usecase>
