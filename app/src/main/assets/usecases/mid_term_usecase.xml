<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 中线量化 UseCase

  最复杂的 Pipeline，含中线独有的 7 个步骤：
    1. 大盘分析+自适应参数（动态阈值/数量限制）
    2. 多周期热门股聚合（3/5/10/30/50/100天涨幅Top3）
    3. 跨日聚合（回溯5天策略命中频次）
    4. 新闻力度计算（近3天新闻影响力×情绪）
    5. 板块轮动惩罚（防止板块过度集中）
    6. 新闻拦截+技术过滤（4条规则）
    7. 腾龙换鸟（仓位不足时自动换股）

  V1 Pipeline（data_prep + strategy_screening）负责数据准备和策略筛选，
  V2 DAG Pipeline（mid_term_pipeline.xml）负责中线独有的完整流程。
  BEARISH 时 scoreThreshold=55, maxCount=2。
-->
<usecase id="mid_term" name="中线量化">
  <description>自适应参数→多周期热门→策略筛选→合并增强→跨日聚合→AI精选→主力过滤→新闻拦截→腾龙换鸟</description>
  <steps>
    <pipeline ref="usecases/market_rotation_pipeline.xml" name="市场公共研判（大盘→风格→板块）" />
    <pipeline ref="usecases/stock_picking_common_pipeline.xml" name="选股公共数据准备（股票池/自适应参数/风控）" />
    <!-- 周期×环境矩阵路由：根据 n_adaptive 输出的大盘方向选择环境专属 pipeline（smalltool usecase_matrix 9格） -->
    <pipeline ref="usecases/mid_term_bullish_pipeline.xml" name="中线·牛市DAG（S5深回踩严 tp+3.0/sl-8.0）" if="${n_adaptive}.direction == 'BULLISH'" />
    <pipeline ref="usecases/mid_term_oscillation_pipeline.xml" name="中线·震荡DAG（S1粘合突破 tp+3.0/sl-8.0）" if="${n_adaptive}.direction == 'OSCILLATION'" />
    <pipeline ref="usecases/mid_term_bearish_pipeline.xml" name="中线·熊市DAG（S5深回踩+资金流 tp+3.0/sl-8.0）" if="${n_adaptive}.direction == 'BEARISH'" />
  </steps>
  <config>
    <param name="orderType" value="MidTermQuant" />
    <param name="maxHoldings" value="5" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="mid" />
  </config>
</usecase>
