<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 中線量化 UseCase

  最複雜的 Pipeline，含中線獨有的 7 個步驟：
    1. 大盤分析+自適應參數（動態閾值/數量限制）
    2. 多周期熱門股聚合（3/5/10/30/50/100天漲幅Top3）
    3. 跨日聚合（回溯5天策略命中頻次）
    4. 新聞力度計算（近3天新聞影響力×情緒）
    5. 板塊輪動懲罰（防止板塊過度集中）
    6. 新聞攔截+技術過濾（4條規則）
    7. 騰龍換鳥（倉位不足時自動換股）

  V1 Pipeline（data_prep + strategy_screening）負責數據準備和策略篩選，
  V2 DAG Pipeline（mid_term_pipeline.xml）負責中線獨有的完整流程。
  BEARISH 時 scoreThreshold=55, maxCount=2。
-->
<usecase id="mid_term" name="中線量化">
  <description>自適應參數→多周期熱門→策略篩選→合併增強→跨日聚合→AI精選→主力過濾→新聞攔截→騰龍換鳥</description>
  <steps>
    <pipeline ref="usecases/mid_term_pipeline.xml" name="中線DAG流程" />
  </steps>
  <config>
    <param name="orderType" value="MidTermQuant" />
    <param name="maxHoldings" value="3" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="mid" />
  </config>
</usecase>
