<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 选股公共 L0/L1 DAG Pipeline — 四周期共用数据准备层

  从四个周期 pipeline（超短/短/中/长）中抽取的公共 L0/L1 节点，统一管理：
    Layer 0 (并行): data_import（数据导入检查）, market_context（市场上下文）, bg_manager（后台暂停/恢复）, adaptive_params（大盘分析+自适应参数）
    Layer 1 (并行): stock_pool（股票池）, market_ma_unified（大盘均线统一检查，market_check 分组）, holding_guard（持仓风控）

  选股公共 L0/L1 在 usecase 中置于「市场研判 pipeline」之后、「周期 pipeline」之前执行：
    - stageOutputs 跨 pipeline 持久，周期 pipeline 的 n_cand/n_heat/n_orders 等下游通过
      context.getStageOutput("n_pool") / context.getAdaptiveParams() 等内部兜底读取，无需显式边。
    - 策略动态注入在 Java 层完成：注入器检测到本 pipeline 无 n_pool 节点时，
      策略节点以根节点运行，从 stageOutputs 兜底读取股票池。

  参数说明（取四个周期中的多数值）：
    - n_import: days=60 / minSnapshots=100（超短原为 30/100，统一为 60/100）
    - n_ma_unified: threshold=0.02 / checkMode=full（超短原为 0.015，统一为 0.02）
-->
<DagPipeline id="stock_picking_common_dag" name="选股公共 L0/L1 Pipeline" description="数据导入→市场上下文→自适应参数→股票池→大盘均线检查→持仓风控（四周期共用数据准备层）">

  <!-- ══════════ NodeList ══════════ -->
  <NodeList>
    <!-- 数据准备 Layer 0 -->
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="60" />
        <param name="minSnapshots" value="100" />
      </config>
    </Node>
    <Node id="n_ctx" name="市场上下文" module="market_context" />
    <Node id="n_bg" name="后台暂停/恢复" module="bg_manager" />
    <Node id="n_adaptive" name="大盘分析+自适应参数" module="adaptive_params" />

    <!-- Layer 1 -->
    <Node id="n_pool" name="股票池" module="stock_pool" />

    <!-- Layer 1: 股票池清洗（ST 无条件排除 + 主板开关时排除科创/创业），减小输入源规模 -->
    <Node id="n_pool_filter" name="股票池过滤(ST/科创/创业)" module="pool_filter" />

    <!-- 大盘均线检查 Pipeline 分组 -->
    <Pipeline id="market_check" name="大盘均线检查">
      <NodeList>
        <Node id="n_ma_unified" name="大盘均线统一检查" module="market_ma_unified">
          <config>
            <param name="threshold" value="0.02" />
            <param name="checkMode" value="full" />
          </config>
        </Node>
      </NodeList>
    </Pipeline>

    <!-- Layer 1（并行）: 持仓风控 — 每次必跑，评估止损/止盈/策略退出 -->
    <Node id="n_guard" name="持仓风控" module="holding_guard" />
  </NodeList>

  <!-- ══════════ Links ══════════ -->
  <Links>
    <!-- Layer 0 → 1: 数据导入 → 股票池（确保数据充足） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 数据导入 → 大盘均线统一检查（与股票池并行） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ma_unified</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市场上下文 → 股票池 -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- 股票池 → 股票池过滤（ST/科创/创业），输出覆盖写回 n_pool -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool_filter</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市场上下文 → 持仓风控（并行，每次必评估持仓） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
