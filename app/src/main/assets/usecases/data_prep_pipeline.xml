<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 數據準備 Pipeline（共享）

  市場上下文構建 → 股票池加載。2 個 Node 串聯，需要獨立 Pipeline。
  量化選股、短線量化、中線量化 共用此 Pipeline。
-->
<pipeline id="data_prep" name="數據準備" description="市場上下文構建→股票池加載" version="1">
  <nodes>
    <node id="n_ctx" module="market_context" />
    <node id="n_pool" module="stock_pool" />
  </nodes>
  <stages>
    <stage name="數據準備" parallel="false">
      <linkList name="市場上下文+股票池">
        <link from="n_ctx" to="n_pool" />
      </linkList>
    </stage>
  </stages>
</pipeline>
