<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 超短線量化 UseCase

  持倉 1 天，純技術面，隔夜情緒溢價。
  流程最精簡：市場上下文 → 股票池 → 策略篩選 → 板塊加權 → AI精選 → 主力過濾 → 訂單生成 → 持倉合併/擬合保存
-->
<usecase id="ultra_short" name="超短線量化">
  <description>市場上下文→股票池→策略篩選→板塊加權→AI精選→主力過濾→訂單生成→持倉合併/擬合保存</description>
  <steps>
    <pipeline ref="usecases/ultra_short_pipeline.xml" name="超短線DAG流程" />
  </steps>
  <config>
    <param name="orderType" value="UltraShortQuant" />
    <param name="maxHoldings" value="6" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="ultra_short" />
  </config>
</usecase>
