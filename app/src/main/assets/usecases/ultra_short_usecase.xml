<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 超短线量化 UseCase

  持仓 1 天，纯技术面，隔夜情绪溢价。
  流程最精简：市场上下文 → 股票池 → 策略筛选 → 板块加权 → AI精选 → 主力过滤 → 订单生成 → 持仓合并/拟合保存
-->
<usecase id="ultra_short" name="超短线量化">
  <description>市场上下文→股票池→策略筛选→板块加权→AI精选→主力过滤→订单生成→持仓合并/拟合保存</description>
  <steps>
    <pipeline ref="usecases/market_rotation_pipeline.xml" name="市场公共研判（大盘→风格→板块）" />
    <pipeline ref="usecases/stock_picking_common_pipeline.xml" name="选股公共数据准备（股票池/自适应参数/风控）" />
    <!-- 周期×环境矩阵路由：根据 n_adaptive 输出的大盘方向选择环境专属 pipeline（smalltool usecase_matrix 9格） -->
    <pipeline ref="usecases/ultra_short_bullish_pipeline.xml" name="超短·牛市DAG（S4强反转 tp+0.4/sl-0.8）" if="${n_market_direction}.direction == 'BULLISH'" />
    <pipeline ref="usecases/ultra_short_oscillation_pipeline.xml" name="超短·震荡DAG（S4K线反转 tp+0.4/sl-0.8）" if="${n_market_direction}.direction == 'OSCILLATION'" />
    <pipeline ref="usecases/ultra_short_bearish_pipeline.xml" name="超短·熊市DAG（S1严选+环境持续 tp+0.4/sl-0.8）" if="${n_market_direction}.direction == 'BEARISH'" />
  </steps>
  <config>
    <param name="orderType" value="UltraShortQuant" />
    <param name="maxHoldings" value="3" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="ultra_short" />
  </config>
</usecase>
