<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## ETF 持股 top5 UseCase（与 etf_dip / sector_ambush 同构的 XML DAG 单一事实源）

  ★ 与另外两个 ETF usecase 的分工（勿合并，见 etf_industry_scan_usecase.xml 头注）：
    本 usecase 入口 = **ETF 前五重仓覆盖矩阵**：
      统计「哪只个股被多少只行业/主题 ETF 列入前五重仓」→ 覆盖度排行（n 优先，其次合计权重）
      → 输出观察清单 + 每只附多理论投票止损参数。
      与 ETF全行业扫描 的差别：全行业扫描是「个股低吸择时」，本 usecase 是「资金共识覆盖度」。

  数据资产：data/_etf_holdings.json（季报级 funds[27]+stocks[193] 矩阵；APK 内置同名资产）
  双端共用：APK UseCaseLoader 直接加载执行；usecase_pipeline.py 解析同一份 XML。
  参数全部在 pipeline XML（etf_holdings_top5_pipeline.xml）。
-->
<usecase id="etf_holdings_top5" name="ETF持股Top5">
  <description>ETF前五重仓覆盖矩阵 → 覆盖度排行top10(行业ETF优先) → 观察清单 → 多理论投票止损</description>
  <steps>
    <pipeline ref="usecases/etf_holdings_top5_pipeline.xml" name="etf_holdings_top5_dag" />
  </steps>
  <config>
    <param name="orderType" value="EtfHoldingsTop5" />
    <param name="maxHoldings" value="10" />
    <param name="holdingPeriod" value="etf" />
  </config>
</usecase>
