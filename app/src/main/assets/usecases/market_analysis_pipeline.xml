<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 大盘K线分析 Pipeline（独立可复用）

  只做大盘六维分析，不碰个股。
  其他 UseCase 可在 steps 中引用此 Pipeline 作为第一步：
    <pipeline ref="usecases/market_analysis_pipeline.xml" name="大盘分析" />

  输出：AMarketAnalysisEngine.MarketAnalysisResult
  存入 context.stageOutputs["n_a_market"]，后续 Pipeline 可读取。
-->
<DagPipeline id="market_analysis_dag" name="大盘K线分析Pipeline"
    description="大盘K线六维分析（趋势/量能/情绪/状态机）">

  <NodeList>
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="30" />
        <param name="minSnapshots" value="50" />
      </config>
    </Node>
    <Node id="n_a_market" name="大盘K线分析" module="a_market_analysis" />
  </NodeList>

  <Links>
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_a_market</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
