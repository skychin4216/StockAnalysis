<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 長線量化 DAG Pipeline — 高通 Camera Pipeline 風格

  長線特徵：持倉 1 年以上，深度基本面，公司成長+價值，重倉持有。
  不追熱點、不頻繁換股，但需 news_guard 防黑天鵝利空。

  共 19 個 Node：
    Layer 0 (並行): market_context, bg_manager, data_import
    Layer 1 (並行): stock_pool, ma_convergence, sector_stock_pool, holding_guard（依賴 market_context）
    Layer 1.5: candidate_pool（候選池過濾，補齊 Hardcode）
    Layer 2 (並行): signal_merge（策略動態注入）, heat_score（依賴 stock_pool）, defensive_dividend（防守高息）
    Layer 3: sector_boost（依賴 signal_merge + heat_score）→ bounce_reversal
    Layer 4: smart_money_filter（依賴 bounce_reversal）
    Layer 5: news_guard（依賴 smart_money_filter，防重大利空）
    Layer 6: ai_predict（依賴 news_guard，最終裁切 take 5）
    Layer 7: generate_orders（依賴 ai_predict）
    Layer 8 (並行): position_merge, fitting_save（依賴 generate_orders）
-->
<DagPipeline id="long_term_dag" name="長線量化DAG Pipeline" description="市場上下文→股票池+板塊精選池→策略篩選+熱度→板塊加權→主力過濾→新聞攔截→AI精選→訂單生成→持倉合併/擬合保存">

  <!-- ══════════ NodeList ══════════ -->
  <NodeList>
    <!-- 數據準備 Layer 0 -->
    <Node id="n_import" name="數據導入檢查" module="data_import">
      <config>
        <param name="days" value="60" />
        <param name="minSnapshots" value="100" />
      </config>
    </Node>
    <Node id="n_ctx" name="市場上下文" module="market_context" />
    <Node id="n_bg" name="後臺暫停/恢復" module="bg_manager" />

    <!-- Layer 1 -->
    <Node id="n_pool" name="股票池" module="stock_pool" />
    <Node id="n_ma_conv" name="均線粘合偵測" module="ma_convergence" />

    <!-- Layer 1（並行）: 板塊精選池（依賴 market_context，輸出存入 context 供候選池讀取） -->
    <Node id="n_sector_pool" name="板塊精選池" module="sector_stock_pool" />

    <!-- Layer 1（並行）: 持倉風控 — 每次必跑，評估止損/止盈/策略退出 -->
    <Node id="n_guard" name="持倉風控" module="holding_guard" />

    <!-- Layer 1.5: 候選池過濾（補齊 Hardcode） -->
    <Node id="n_cand" name="候選池過濾" module="candidate_pool" />

    <!-- 聚合 Layer 2 -->
    <Node id="n_merge" name="信號合併" module="signal_merge" />

    <!-- 熱度計算 Layer 2（並行，依賴 stock_pool，輸出存入 context 供板塊加權讀取） -->
    <Node id="n_heat" name="熱度計算" module="heat_score" />

    <!-- 增強 Layer 3 -->
    <Node id="n_boost" name="板塊加權" module="sector_boost" />
    <Node id="n_bounce" name="跌後反彈加分" module="bounce_reversal" />

    <!-- 防守高息（熊市/震盪時啟動，尋找銀行/電力/高速公路等高息防禦股） -->
    <Node id="n_defensive" name="防守高息" module="defensive_dividend">
      <config>
        <param name="maxPb" value="1.5" />
        <param name="maxDebt" value="70" />
        <param name="maxCandidates" value="5" />
      </config>
    </Node>

    <!-- AI+過濾 Layer 4-5 -->
    <Node id="n_ai" name="AI精選" module="ai_predict" />
    <Node id="n_smart" name="主力資金過濾" module="smart_money_filter">
      <config>
        <param name="minScore" value="55" />
      </config>
    </Node>

    <!-- 新聞攔截 Layer 6（防黑天鵝） -->
    <Node id="n_newsguard" name="新聞攔截+技術過濾" module="news_guard">
      <config>
        <param name="impactThreshold" value="75" />
        <param name="sentimentThreshold" value="-30" />
      </config>
    </Node>

    <!-- 訂單生成 Layer 7 -->
    <Node id="n_orders" name="買入訂單生成" module="generate_orders">
      <config>
        <param name="maxHoldings" value="5" />
        <param name="orderType" value="LongTermQuant" />
      </config>
    </Node>

    <!-- 持倉合併 + 擬合 Layer 8（並行） -->
    <Node id="n_merge_pos" name="持倉合併" module="position_merge" />
    <Node id="n_fit" name="擬合計算+保存" module="fitting_save" />
  </NodeList>

  <!-- ══════════ Links ══════════ -->
  <Links>
    <!-- Layer 0 → 1: 數據導入 → 股票池（確保數據充足） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 數據導入 → 均線粘合偵測（與股票池並行） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ma_conv</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 股票池 -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 持倉風控（並行，每次必評估持倉） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市場上下文 → 板塊精選池（並行，輸出存入 context 供候選池讀取） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_sector_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 1.5: 股票池 → 候選池過濾（補齊 Hardcode） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_cand</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 防守高息（熊市/震盪時啟動） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_defensive</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 熱度計算（並行，輸出存入 context 供板塊加權讀取） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_heat</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 防守高息 → 信號合併（防守候選併入主流程） -->
    <Link>
      <SourceNodeId>n_defensive</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 2: 候選池過濾 → 信號合併（策略動態注入在 Java 層完成） -->
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 信號合併 → 板塊加權 -->
    <Link>
      <SourceNodeId>n_merge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 熱度計算 → 板塊加權（熱度作為板塊加權輸入） -->
    <Link>
      <SourceNodeId>n_heat</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板塊加權 → 跌後反彈加分 -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_bounce</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 4: 跌後反彈加分 → 主力資金過濾（先過濾再AI精選） -->
    <Link>
      <SourceNodeId>n_bounce</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 主力資金過濾 → 新聞攔截+技術過濾 -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_newsguard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 5 → 6: 新聞攔截 → AI精選（最終裁切 take 5） -->
    <Link>
      <SourceNodeId>n_newsguard</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ai</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 6 → 7: AI精選 → 買入訂單生成 -->
    <Link>
      <SourceNodeId>n_ai</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 買入訂單生成 → 持倉合併 -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge_pos</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: 買入訂單生成 → 擬合保存（並行） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_fit</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
