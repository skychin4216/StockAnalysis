<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## AI+主力資金過濾 Pipeline（共享）

  AI 精選 → 主力資金過濾。2 個 Node 串聯。
  短線量化和中線量化共用此 Pipeline，量化選股不使用。
-->
<pipeline id="ai_filter" name="AI+主力過濾" description="AI精選→主力資金過濾" version="1">
  <nodes>
    <node id="n_ai" module="ai_predict" />
    <node id="n_smart" module="smart_money_filter">
      <config>
        <param name="minScore" value="55" />
      </config>
    </node>
  </nodes>
  <stages>
    <stage name="AI+主力過濾" parallel="false">
      <linkList name="AI精選+主力過濾">
        <link from="n_ai" to="n_smart" />
      </linkList>
    </stage>
  </stages>
</pipeline>
