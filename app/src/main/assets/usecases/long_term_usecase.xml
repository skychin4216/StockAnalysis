<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 长线量化 UseCase

  持仓 1 年以上，深度基本面，公司成长+价值。
  流程：市场上下文 → 股票池 → 策略筛选 → 板块加权 → AI精选 → 主力过滤 → 新闻拦截 → 订单生成 → 持仓合并/拟合保存
-->
<usecase id="long_term" name="长线量化">
  <description>市场上下文→股票池→策略筛选→板块加权→AI精选→主力过滤→新闻拦截→订单生成→持仓合并/拟合保存</description>
  <steps>
    <pipeline ref="usecases/market_rotation_pipeline.xml" name="市场公共研判（大盘→风格→板块）" />
    <pipeline ref="usecases/stock_picking_common_pipeline.xml" name="选股公共数据准备（股票池/自适应参数/风控）" />
    <!-- 长线×环境矩阵路由：根据 n_adaptive 输出的大盘方向（BULLISH/OSCILLATION/BEARISH）选择环境专属 pipeline -->
    <pipeline ref="usecases/long_term_bullish_pipeline.xml" name="长线·牛市DAG（S5深回踩严 tp=+50/sl=-8/hold=40）" if="${n_adaptive}.direction == 'BULLISH'" />
    <pipeline ref="usecases/long_term_oscillation_pipeline.xml" name="长线·震荡DAG（S1粘合突破 tp=+40/sl=-12/hold=40）" if="${n_adaptive}.direction == 'OSCILLATION'" />
    <pipeline ref="usecases/long_term_bearish_pipeline.xml" name="长线·熊市DAG（S5深回踩+资金流 tp=+50/sl=-12/hold=40）" if="${n_adaptive}.direction == 'BEARISH'" />
  </steps>
  <config>
    <param name="orderType" value="LongTermQuant" />
    <param name="maxHoldings" value="5" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="long" />
  </config>
</usecase>
