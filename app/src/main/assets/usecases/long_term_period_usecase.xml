<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 长线量化·周期专属 UseCase（一键建仓并行版）

  不含公共研判（市场公共研判 + 选股公共数据准备由工作台统一执行一次，stageOutputs 播种）。
  直接按 n_adaptive 输出的大盘方向路由周期×环境专属 pipeline。
  依赖 seedStageOutputs 中的 n_adaptive / n_pool / n_params 等（缺失时回退完整 usecase）。
-->
<usecase id="long_term_period" name="长线周期专属（并行）">
  <description>周期专属：牛市/震荡/熊市 DAG（公共研判由工作台统一执行）</description>
  <steps>
    <!-- 周期×环境矩阵路由：根据 n_adaptive（公共研判播种）输出的大盘方向选择环境专属 pipeline -->
    <pipeline ref="usecases/long_term_bullish_pipeline.xml" name="长线·牛市DAG（S5深回踩严 tp=+50/sl=-8/hold=40）" if="${n_market_direction}.direction == 'BULLISH'" />
    <pipeline ref="usecases/long_term_oscillation_pipeline.xml" name="长线·震荡DAG（S1粘合突破 tp=+40/sl=-12/hold=40）" if="${n_market_direction}.direction == 'OSCILLATION'" />
    <pipeline ref="usecases/long_term_bearish_pipeline.xml" name="长线·熊市DAG（S5深回踩+资金流 tp=+50/sl=-12/hold=40）" if="${n_market_direction}.direction == 'BEARISH'" />
  </steps>
  <config>
    <param name="orderType" value="LongTermQuant" />
    <param name="maxHoldings" value="5" />
    <param name="maxStocksPerStrategy" value="15" />
    <param name="holdingPeriod" value="long" />
  </config>
</usecase>
