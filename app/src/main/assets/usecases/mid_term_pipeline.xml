<?xml version="1.0" encoding="UTF-8"?>
<!--
  ## 中线量化 DAG Pipeline v3 — 高通 Camera Pipeline 风格

  扁平 DAG 结构：NodeList 定义节点，Links 定义依赖。
  拓扑排序自动推导并行度，同层节点自动并行执行。

  共 20 个 Node（原 17 + 补齐 3）：
    Layer 0 (并行): adaptive_params, multi_period_hot, market_context, bg_manager
    Layer 1 (并行): stock_pool, sector_stock_pool（补齐 Hardcode，依赖 market_context）
    Layer 1.5: candidate_pool（补齐 Hardcode，依赖 stock_pool）
    Layer 2 (并行): signal_merge（策略动态注入）, heat_score（依赖 stock_pool）, cross_day_aggregation（依赖 stock_pool）
    Layer 3: sector_boost（依赖 signal_merge）→ bounce_reversal
    Layer 4 (并行): news_strength, rotation_penalty（依赖 sector_boost）
    Layer 5: smart_money_filter（依赖 bounce_reversal + news_strength）
    Layer 6: news_guard（依赖 smart_money_filter）
    Layer 7: ai_predict（依赖 news_guard，最终裁切 take 5）
    Layer 8: generate_orders（依赖 ai_predict）
    Layer 9: swap_weak（依赖 generate_orders）, fitting_save（依赖 generate_orders，并行）
    Layer 9.5: position_merge（依赖 swap_weak，换鸟后再入库）
    Layer 10: crosstab_publish（依赖 position_merge，补齐 Hardcode）
-->
<DagPipeline id="mid_term_dag" name="中线量化DAG Pipeline" description="自适应参数→多周期热门→策略筛选→合并增强→跨日聚合→主力过滤→新闻拦截→AI精选→订单生成→持仓合并/腾龙换鸟/拟合保存">

  <!-- ══════════ NodeList ══════════ -->
  <NodeList>
    <!-- 中线独有：数据源 Layer 0 -->
    <Node id="n_import" name="数据导入检查" module="data_import">
      <config>
        <param name="days" value="60" />
        <param name="minSnapshots" value="100" />
      </config>
    </Node>
    <Node id="n_adaptive" name="大盘分析+自适应参数" module="adaptive_params" />
    <Node id="n_multihot" name="多周期热门股聚合" module="multi_period_hot" />

    <!-- 共用：数据准备 Layer 0-1 -->
    <Node id="n_ctx" name="市场上下文" module="market_context" />
    <Node id="n_pool" name="股票池" module="stock_pool" />

    <!-- 大盘均线检查 Pipeline 分组（统一节点，可配置阈值） -->
    <Pipeline id="market_check" name="大盘均线检查">
      <NodeList>
        <Node id="n_ma_unified" name="大盘均线统一检查" module="market_ma_unified">
          <config>
            <param name="threshold" value="0.02" />
            <param name="checkMode" value="full" />
          </config>
        </Node>
      </NodeList>
    </Pipeline>

    <!-- 中线补齐：板块精选池 Layer 1（并行，依赖 market_context） -->
    <Node id="n_sector_pool" name="板块精选池" module="sector_stock_pool" />

    <!-- Layer 1（并行）: 持仓风控 — 每次必跑，评估止损/止盈/策略退出 -->
    <Node id="n_guard" name="持仓风控" module="holding_guard" />

    <!-- 中线补齐：候选池过滤 Layer 1.5（依赖 stock_pool） -->
    <Node id="n_cand" name="候选池过滤" module="candidate_pool" />

    <!-- 中线补齐：后台管理 Layer 0（并行） -->
    <Node id="n_bg" name="后台暂停/恢复" module="bg_manager" />

    <!-- 中线补齐：热度计算 Layer 2（依赖 stock_pool） -->
    <Node id="n_heat" name="热度计算" module="heat_score" />

    <!-- 中线独有：聚合 Layer 2 -->
    <Node id="n_crossday" name="跨日聚合" module="cross_day_aggregation">
      <config>
        <param name="windowDays" value="5" />
        <param name="topN" value="20" />
      </config>
    </Node>

    <!-- 共用：聚合+增强 Layer 2-4 -->
    <Node id="n_merge" name="信号合并" module="signal_merge" />
    <Node id="n_boost" name="板块加权" module="sector_boost" />
    <Node id="n_bounce" name="跌后反弹加分" module="bounce_reversal" />
    <Node id="n_strict" name="六项严选检查" module="strict_selection">
      <config>
        <param name="peThreshold" value="30.0" />
        <param name="maDivergenceThreshold" value="0.03" />
        <param name="lookbackDays" value="60" />
      </config>
    </Node>
    <Node id="n_base_guard" name="打底仓守门" module="base_position_guard">
      <config><param name="holdingPeriod" value="MID" /></config>
    </Node>
    <Node id="n_ancestral" name="大A祖训" module="ancestral_rules">
      <config><param name="holdingPeriod" value="MID" /></config>
    </Node>
    <Node id="n_inst_tips" name="机构线索加分" module="inst_tips" />

    <!-- 中线独有：增强 Layer 4 -->
    <Node id="n_news_str" name="新闻力度计算" module="news_strength" />
    <Node id="n_rot_pen" name="板块轮动惩罚" module="rotation_penalty" />

    <!-- 防守高息（熊市/震荡时启动，寻找银行/电力/高速公路等高息防御股） -->
    <Node id="n_defensive" name="防守高息" module="defensive_dividend">
      <config>
        <param name="maxPb" value="1.5" />
        <param name="maxDebt" value="70" />
        <param name="maxCandidates" value="5" />
      </config>
    </Node>

    <!-- 共用：AI+过滤 Layer 5-6 -->
    <Node id="n_ai" name="AI精选" module="ai_predict" />
    <Node id="n_smart" name="主力资金过滤" module="smart_money_filter">
      <config>
        <param name="minScore" value="55" />
      </config>
    </Node>
    <Node id="n_candle" name="K线形态侦测" module="candle_pattern" />

    <!-- 中线独有：过滤 Layer 7（依赖 smart_money_filter） -->
    <Node id="n_newsguard" name="新闻拦截+技术过滤" module="news_guard">
      <config>
        <param name="impactThreshold" value="75" />
        <param name="sentimentThreshold" value="-30" />
      </config>
    </Node>

    <!-- 中线补齐：订单生成 Layer 8 -->
    <Node id="n_orders" name="买入订单生成" module="generate_orders">
      <config>
        <param name="maxHoldings" value="6" />
        <param name="orderType" value="MidTermQuant" />
      </config>
    </Node>

    <!-- 中线补齐：持仓合并 Layer 9 -->
    <Node id="n_merge_pos" name="持仓合并" module="position_merge" />

    <!-- 中线补齐：跨 Tab 发布 Layer 10（依赖 position_merge） -->
    <Node id="n_crosstab" name="跨Tab发布" module="crosstab_publish" />

    <!-- 中线独有：交易动作 Layer 9（并行） -->
    <Node id="n_swap" name="腾龙换鸟" module="swap_weak">
      <config>
        <param name="maxHoldings" value="6" />
      </config>
    </Node>
  </NodeList>

  <!-- ══════════ Links ══════════ -->
  <Links>
    <!-- Layer 0 → 1: 数据导入 → 股票池（确保数据充足） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 数据导入 → 大盘均线统一检查（与股票池并行） -->
    <Link>
      <SourceNodeId>n_import</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ma_unified</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市场上下文 → 股票池 -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市场上下文 → 板块精选池（补齐 Hardcode，并行） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_sector_pool</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 1: 市场上下文 → 持仓风控（并行，每次必评估持仓） -->
    <Link>
      <SourceNodeId>n_ctx</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 2: 大盘分析 → 信号合并（自适应参数注入） -->
    <Link>
      <SourceNodeId>n_adaptive</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 2: 多周期热门 → 跨日聚合（热门股池注入） -->
    <Link>
      <SourceNodeId>n_multihot</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_crossday</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 1.5: 板块精选池 → 候选池过滤（板块股票注入候选池） -->
    <Link>
      <SourceNodeId>n_sector_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_cand</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 1.5: 股票池 → 候选池过滤（补齐 Hardcode） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_cand</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1.5 → 2: 候选池过滤 → 信号合并（策略动态注入在 Java 层完成） -->
    <Link>
      <SourceNodeId>n_cand</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 热度计算（中线补齐） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_heat</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 跨日聚合（中线独有） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_crossday</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 1 → 2: 股票池 → 防守高息（熊市/震荡时启动） -->
    <Link>
      <SourceNodeId>n_pool</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_defensive</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 防守高息 → 信号合并（防守候选并入主流程） -->
    <Link>
      <SourceNodeId>n_defensive</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 信号合并 → 板块加权 -->
    <Link>
      <SourceNodeId>n_merge</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 0 → 3: 大盘均线统一检查 → 板块加权（MA 收敛影响板块加权） -->
    <Link>
      <SourceNodeId>n_ma_unified</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 2 → 3: 热度计算 → 板块加权（热度作为板块加权输入） -->
    <Link>
      <SourceNodeId>n_heat</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_boost</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 4: 板块加权 → 新闻力度 / 轮动惩罚（并行评分） -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_news_str</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_rot_pen</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3 → 3.5: 板块加权 → 跌后反弹加分 -->
    <Link>
      <SourceNodeId>n_boost</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_bounce</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 3.5a: 跌后反弹加分 → 打底仓守门 -->
    <Link>
      <SourceNodeId>n_bounce</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_strict</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5 → 3.5a: 六项严选检查 → 打底仓守门 -->
    <Link>
      <SourceNodeId>n_strict</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_base_guard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5a → 3.5b: 打底仓守门 → 大A祖训 -->
    <Link>
      <SourceNodeId>n_base_guard</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ancestral</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.5b → 3.6: 大A祖训 → 机构线索加分 -->
    <Link>
      <SourceNodeId>n_ancestral</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_inst_tips</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 3.6 → 5: 机构线索加分 → 主力资金过滤（先过滤再AI精选） -->
    <Link>
      <SourceNodeId>n_inst_tips</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 4 → 5: 新闻力度 → 主力资金过滤（新闻评分存入context供后续读取） -->
    <Link>
      <SourceNodeId>n_news_str</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_smart</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 5 → 6: 主力资金过滤 → 新闻拦截+技术过滤 -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_newsguard</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 5 → 6: 主力资金过滤 → K线形态侦测（并行，辅助提醒） -->
    <Link>
      <SourceNodeId>n_smart</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_candle</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 6 → 7: 新闻拦截 → AI精选（最终裁切 take 5） -->
    <Link>
      <SourceNodeId>n_newsguard</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_ai</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 7 → 8: AI精选 → 买入订单生成 -->
    <Link>
      <SourceNodeId>n_ai</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_orders</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 8 → 9 → 10: 买入订单生成 → 腾龙换鸟 → 持仓合并（序列：先卖后买避免竞态） -->
    <Link>
      <SourceNodeId>n_swap</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_merge_pos</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 9 → 10: 持仓合并 → 跨 Tab 发布（补齐 Hardcode） -->
    <Link>
      <SourceNodeId>n_merge_pos</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_crosstab</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>

    <!-- Layer 8 → 9: 买入订单生成 → 腾龙换鸟（序列链第一步） -->
    <Link>
      <SourceNodeId>n_orders</SourceNodeId>
      <SourcePortId>0</SourcePortId>
      <TargetNodeId>n_swap</TargetNodeId>
      <TargetPortId>0</TargetPortId>
    </Link>
  </Links>
</DagPipeline>
