{
  "period": "SHORT",
  "mode": "QUICK",
  "description": "短线 Agent 配置：默认 QUICK 模式，盘后可切换 PIPELINE 深度分析",
  "agents": ["StockAnalysisAgent", "RiskManagementAgent"],
  "parallel": true,
  "timeout": 30,
  "maxBatchSize": 8,
  "alternateMode": {
    "mode": "PIPELINE",
    "trigger": "盘后深度分析",
    "agents": ["AgentPipelineOrchestrator"],
    "timeout": 120,
    "maxBatchSize": 5
  },
  "postProcess": {
    "sortBy": "overallScore",
    "maxResults": 3,
    "stopLoss": -8.0,
    "takeProfit": 15.0,
    "autoSellEngine": true,
    "comment": "短线持仓1天~2周，硬止损-8%"
  }
}
