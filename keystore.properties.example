# 复制本文件为 keystore.properties（与 build.gradle.kts 同级，勿提交到 git）
# 用于 Release APK 签名；若缺少此文件，assembleRelease 将回退使用 debug 签名。
#
# 生成正式密钥库示例（Windows 命令行）：
#   keytool -genkeypair -v -keystore release.keystore -alias stockanalysis ^
#           -keyalg RSA -keysize 2048 -validity 36500 -storetype PKCS12
#
# storeFile 为相对路径（相对项目根目录）或绝对路径

storeFile=release.keystore
storePassword=你的密钥库密码
keyAlias=stockanalysis
keyPassword=你的密钥别名密码
