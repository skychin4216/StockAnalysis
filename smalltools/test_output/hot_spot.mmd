graph TD

    %% 熱點驅動短線 | id=hot_spot
    %% 從熱門板塊成分股中篩選動量+新聞+主力資金共振個股

    %% ===== Layer 0 =====
    subgraph L0["Layer 0"]
        hs_source(["熱門板塊源"]):::dataSource
    end

    %% ===== Layer 1 =====
    subgraph L1["Layer 1"]
        hs_momentum["動量過濾"]:::filter
    end

    %% ===== Layer 2 =====
    subgraph L2["Layer 2"]
        hs_news_filter["新聞過濾"]:::filter
    end

    %% ===== Layer 3 =====
    subgraph L3["Layer 3"]
        hs_smart_money["主力資金過濾"]:::filter
    end

    %% ===== Layer 4 =====
    subgraph L4["Layer 4"]
        hs_score_sort[("評分排序")]:::aggregation
    end

    %% ===== Layer 5 =====
    subgraph L5["Layer 5"]
        hs_output[/"結果輸出"\]:::dataTransform
    end

    %% ===== 連線 =====
    hs_source --> hs_momentum
    hs_momentum --> hs_news_filter
    hs_news_filter --> hs_smart_money
    hs_smart_money --> hs_score_sort
    hs_score_sort --> hs_output

    %% ===== 樣式定義 =====
    classDef dataSource fill:#059669,stroke:#ffffff,stroke-width:1px,color:#ffffff
    classDef filter fill:#DC2626,stroke:#ffffff,stroke-width:1px,color:#ffffff
    classDef aggregation fill:#4F46E5,stroke:#ffffff,stroke-width:1px,color:#ffffff
    classDef dataTransform fill:#6B7280,stroke:#ffffff,stroke-width:1px,color:#ffffff
