flowchart TB
    subgraph APK["APK (Android · 客户端)"]
        A1["量化工作台\nPcCandidatesDialog"] --> A2["📡 远程面板\nRemoteControlPanel/Dialog"]
        A2 --> A3["PcBridgeClient.kt\n业务 API（无地址概念）"]
        A3 --> A6["CosRelayClient.kt\n信封 + HMAC 元数据签名"]
        A4["任务卡片列表\n状态/日志/取消"] --> A2
        A5["2s 轮询增量日志"] --> A4
    end

    subgraph RELAY["联网中继 (2026-09-13 取代局域网/IP)"]
        R1["腾讯云 COS\npc/inbox · pc/outbox/{deviceId}"]
    end

    subgraph PC["PC (AutoQuant-GUI.exe · 服务端)"]
        B0["relay_worker.py\n轮询 inbox → 本机 API → outbox"] --> B1["data_service.py\nThreadingHTTPServer 127.0.0.1:8888"]
        B1 --> B2["remote_control.py\nRemoteControl"]
        B2 --> B3["任务队列\nThreadPoolExecutor(2)"]
        B3 --> B4["任务持久化\ndata/remote_tasks.json"]
        B1 --> B5["本机 API 鉴权\ndata/remote_token.txt（仅本机）"]
    end

    subgraph EXEC["执行器 (PC 侧)"]
        C1["smalltools 脚本\n选股/回测/拟合/刷新/上传"] --> C2["输出: candidates_quant.json\nbacktest_params.json"]
        C3["CodeBuddy CLI\ncodebuddy run &lt;prompt&gt;"]
        C4["adb 广播\n触发 APK 刷新"]
    end

    subgraph CLOUD["云端"]
        D1["COS: candidates / params\n/ market_data.db / phone_*.zip"]
    end

    A6 -- "PUT 命令 / 轮询应答" --> R1
    R1 -- "轮询 pc/inbox" --> B0
    B0 -- "应答写 pc/outbox" --> R1
    B1 -- "本机 token 校验" --> B5
    B3 -- "subprocess" --> C1
    B3 -- "subprocess" --> C3
    B3 -- "subprocess" --> C4
    C1 --> C2
    C2 --> D1
    D1 -- "APK 下载候选/参数" --> A1
    C4 -- "adb broadcast" --> A4
